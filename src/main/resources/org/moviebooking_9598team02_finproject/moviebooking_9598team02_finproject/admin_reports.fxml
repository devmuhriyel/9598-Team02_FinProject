        </padding>

            <Label prefWidth="1.7976931348623157E308" style="-fx-text-fill: #FFFFFF; -fx-padding: 8 10; -fx-cursor: hand;" text="DASHBOARD" />

            <Label prefWidth="1.7976931348623157E308" style="-fx-text-fill: #FFFFFF; -fx-padding: 8 10; -fx-cursor: hand;" text="MOVIE MANAGEMENT" />

            <Label prefWidth="1.7976931348623157E308" style="-fx-text-fill: #FFFFFF; -fx-padding: 8 10; -fx-cursor: hand;" text="SHOWTIME SCHEDULING" />

            <Label prefWidth="1.7976931348623157E308" style="-fx-text-fill: #FFFFFF; -fx-padding: 8 10; -fx-cursor: hand;" text="BOOKING MANAGEMENT" />

            <Label prefWidth="1.7976931348623157E308" style="-fx-text-fill: #FFFFFF; -fx-padding: 8 10; -fx-cursor: hand;" text="CUSTOMER MANAGEMENT" />

            <Label prefWidth="1.7976931348623157E308" style="-fx-text-fill: #FFC72C; -fx-background-color: #1A1A1A; -fx-padding: 8 10; -fx-font-weight: bold; -fx-border-radius: 5; -fx-background-radius: 5;" text="REPORTS &amp; ANALYTICS"> </Label>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: #1A1A1A; -fx-border-insets: 0; -fx-padding: 0;">
            <content>
                <VBox spacing="20.0" style="-fx-background-color: #1A1A1A;"> <padding>
                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                </padding>

                    <Label style="-fx-text-fill: #FFFFFF; -fx-font-weight: bold;" text="Operational Reports &amp; Analytics">
                        <font><Font size="22.0" /></font>
                    </Label>
                    <Label style="-fx-text-fill: #AAAAAA;" text="Generate and view deep insights into sales, movie performance, and attendance.">
                        <font><Font size="14.0" /></font>
                    </Label>

                    <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-padding: 15; -fx-background-color: #2e2e2e; -fx-background-radius: 8;">
                        <Label style="-fx-text-fill: #FFFFFF;" text="Time Period:" />
                        <ComboBox promptText="Select Preset" style="-fx-background-color: #404040; -fx-prompt-text-fill: #AAAAAA;">
