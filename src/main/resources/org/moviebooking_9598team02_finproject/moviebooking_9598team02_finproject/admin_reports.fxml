<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.geometry.Insets?>
<?import java.lang.String?>

<?import javafx.collections.FXCollections?>
<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.moviebooking_9598team02_finproject.moviebooking_9598team02_finproject.Admin.AdminBase"
            prefHeight="720.0" prefWidth="1280.0"
            style="-fx-background-color: #1A1A1A;"> <top>
    <HBox alignment="CENTER_LEFT" prefHeight="60.0" spacing="20.0"
          style="-fx-background-color: #000000; -fx-padding: 0 20 0 20;"> <Label text="CinemaAdmin" style="-fx-text-fill: #FFC72C;"> <font><Font size="24.0" /></font>
    </Label>
        <Region HBox.hgrow="ALWAYS" />
        <Label text="Admin Name | Logout" style="-fx-text-fill: #FFFFFF;"> <font><Font size="14.0" /></font>
        </Label>
    </HBox>
</top>

    <left>
        <VBox prefWidth="220.0" spacing="10.0"
              style="-fx-background-color: #000000; -fx-border-color: #AAAAAA; -fx-border-width: 0 1 0 0;"> <padding>
            <Insets top="20.0" right="10.0" bottom="20.0" left="10.0" />
        </padding>

            <Label text="DASHBOARD" prefWidth="1.7976931348623157E308"
                   style="-fx-text-fill: #FFFFFF; -fx-padding: 8 10; -fx-cursor: hand;" />

            <Label text="MOVIE MANAGEMENT" prefWidth="1.7976931348623157E308"
                   style="-fx-text-fill: #FFFFFF; -fx-padding: 8 10; -fx-cursor: hand;"/>

            <Label text="SHOWTIME SCHEDULING" prefWidth="1.7976931348623157E308"
                   style="-fx-text-fill: #FFFFFF; -fx-padding: 8 10; -fx-cursor: hand;" />

            <Label text="BOOKING MANAGEMENT" prefWidth="1.7976931348623157E308"
                   style="-fx-text-fill: #FFFFFF; -fx-padding: 8 10; -fx-cursor: hand;" />

            <Label text="CUSTOMER MANAGEMENT" prefWidth="1.7976931348623157E308"
                   style="-fx-text-fill: #FFFFFF; -fx-padding: 8 10; -fx-cursor: hand;" />

            <Label text="REPORTS &amp; ANALYTICS" prefWidth="1.7976931348623157E308"
                   style="-fx-text-fill: #FFC72C; -fx-background-color: #1A1A1A; -fx-padding: 8 10; -fx-font-weight: bold; -fx-border-radius: 5; -fx-background-radius: 5;"> </Label>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: #1A1A1A; -fx-border-insets: 0; -fx-padding: 0;">
            <content>
                <VBox spacing="20.0" style="-fx-background-color: #1A1A1A;"> <padding>
                    <Insets top="20.0" right="20.0" bottom="20.0" left="20.0" />
                </padding>

                    <Label text="Operational Reports &amp; Analytics" style="-fx-text-fill: #FFFFFF; -fx-font-weight: bold;">
                        <font><Font size="22.0" /></font>
                    </Label>
                    <Label text="Generate and view deep insights into sales, movie performance, and attendance." style="-fx-text-fill: #AAAAAA;">
                        <font><Font size="14.0" /></font>
                    </Label>

                    <HBox spacing="10.0" alignment="CENTER_LEFT" style="-fx-padding: 15; -fx-background-color: #2e2e2e; -fx-background-radius: 8;">
                        <Label text="Time Period:" style="-fx-text-fill: #FFFFFF;"/>
                        <ComboBox promptText="Select Preset" style="-fx-background-color: #404040; -fx-prompt-text-fill: #AAAAAA;">
                            <items>
                                <FXCollections fx:factory="observableArrayList">
                                    <String fx:value="Last 7 Days" />
                                    <String fx:value="Last 30 Days" />
                                    <String fx:value="Last Quarter" />
                                    <String fx:value="Custom Range" />
                                </FXCollections>
                            </items>
                        </ComboBox>

                        <Label text="Start Date:" style="-fx-text-fill: #FFFFFF;"/>
                        <DatePicker style="-fx-background-color: #404040; -fx-prompt-text-fill: #AAAAAA;"/>

                        <Label text="End Date:" style="-fx-text-fill: #FFFFFF;"/>
                        <DatePicker style="-fx-background-color: #404040; -fx-prompt-text-fill: #AAAAAA;"/>

                        <Button text="Generate Report" style="-fx-background-color: #FFC72C; -fx-text-fill: #000000; -fx-font-weight: bold; -fx-background-radius: 5;"/>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button text="Download CSV" style="-fx-background-color: #00A693; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-background-radius: 5;"/>

                    </HBox>

                    <GridPane hgap="20.0" vgap="20.0">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="60" /> <ColumnConstraints percentWidth="40" /> </columnConstraints>

                        <VBox spacing="10.0" style="-fx-background-color: #2e2e2e; -fx-background-radius: 8; -fx-padding: 20;" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label text="Sales Performance Chart" style="-fx-text-fill: #FFFFFF; -fx-font-weight: bold;">
                                <font><Font size="16.0" /></font>
                            </Label>
                            <StackPane prefHeight="250.0" style="-fx-background-color: #404040;">
                                <Label text="[Placeholder: Sales Revenue Line Chart]" style="-fx-text-fill: #AAAAAA;"/>
                            </StackPane>
                        </VBox>

                        <VBox spacing="10.0" style="-fx-background-color: #2e2e2e; -fx-background-radius: 8; -fx-padding: 20;" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label text="Key Revenue Metrics" style="-fx-text-fill: #FFFFFF; -fx-font-weight: bold;">
                                <font><Font size="16.0" /></font>
                            </Label>
                            <Label text="Total Revenue: P25,480.00" style="-fx-text-fill: #FFFFFF;"/>
                            <Label text="Avg. Ticket Price: P12.50" style="-fx-text-fill: #FFFFFF;"/>
                            <Label text="Total Tickets Sold: 2,038" style="-fx-text-fill: #FFFFFF;"/>
                            <Label text="Refunds Processed: 15" style="-fx-text-fill: #FF0000;"/>
                        </VBox>


                        <VBox spacing="10.0" style="-fx-background-color: #2e2e2e; -fx-background-radius: 8; -fx-padding: 20;" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2">
                            <Label text="Top 5 Performing Movies (by Tickets Sold)" style="-fx-text-fill: #FFFFFF; -fx-font-weight: bold;">
                                <font><Font size="16.0" /></font>
                            </Label>
                            <TableView prefHeight="150.0">
                                <columns>
                                    <TableColumn text="Rank" prefWidth="50" />
                                    <TableColumn text="Movie Title" prefWidth="350" />
                                    <TableColumn text="Tickets Sold" prefWidth="150" />
                                    <TableColumn text="Total Revenue" prefWidth="150" />
                                </columns>
                                <placeholder>
                                    <Label text="Run report to view data." style="-fx-text-fill: #AAAAAA;" />
                                </placeholder>
                            </TableView>
                        </VBox>

                    </GridPane>

                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>