<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #292929;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.moviebooking_9598team02_finproject.moviebooking_9598team02_finproject.Client_Java.Admin_Side.AdminHomeView">

    <top>
        <HBox fx:id="titleBar" alignment="CENTER_LEFT" prefHeight="60.0" spacing="20.0" style="-fx-background-color: #000000; -fx-padding: 0 20 0 20;">
            <Label style="-fx-text-fill: #ff2525; -fx-font-weight: bold;" text="FILMBOOK">
                <font>
                    <Font name="SansSerif Bold" size="24.0" />
                </font>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
         <Label graphicTextGap="0.0" prefHeight="16.0" prefWidth="109.0" style="-fx-text-fill: #ffffff; -fx-font-weight: bold;" text="Welcome back,">
            <font>
               <Font name="SansSerif Bold" size="14.0" />
            </font>
         </Label>
         <Label fx:id="adminName" graphicTextGap="0.0" prefHeight="15.0" prefWidth="106.0" style="-fx-text-fill: #ff2525; -fx-font-weight: bold;" text="Admin Name">
            <font>
               <Font name="SansSerif Bold" size="14.0" />
            </font>
         </Label>
            <Label fx:id="logOutButton" style="-fx-text-fill: #FFFFFF;" text="Logout">
                <font>
                    <Font name="SansSerif Regular" size="14.0" />
                </font>
            </Label>
        </HBox>
    </top>

    <left>
        <VBox fx:id="menuItems" prefWidth="220.0" spacing="10.0" style="-fx-background-color: #1A1A1A; -fx-border-color: #404040; -fx-border-width: 0 1 0 0;">
            <padding>
                <Insets bottom="20.0" left="10.0" right="10.0" top="20.0" />
            </padding>

            <Label fx:id="navDashboard" prefWidth="1.7976931348623157E308" style="-fx-text-fill: #FFFFFF; -fx-background-color: #ff2525; -fx-padding: 8 10; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" text="DASHBOARD" />

            <Label fx:id="navMovie" prefWidth="1.7976931348623157E308" style="-fx-text-fill: #FFFFFF; -fx-padding: 8 10; -fx-cursor: hand;" text="MOVIE MANAGEMENT" />

            <Label fx:id="navShowtime" prefWidth="1.7976931348623157E308" style="-fx-text-fill: #FFFFFF; -fx-padding: 8 10; -fx-cursor: hand;" text="SEAT MANAGEMENT" />

            <Label fx:id="navBooking" prefWidth="1.7976931348623157E308" style="-fx-text-fill: #FFFFFF; -fx-padding: 8 10; -fx-cursor: hand;" text="BOOKING MANAGEMENT" />

            <Label fx:id="navCustomer" prefWidth="1.7976931348623157E308" style="-fx-text-fill: #FFFFFF; -fx-padding: 8 10; -fx-cursor: hand;" text="CUSTOMER MANAGEMENT" />

        </VBox>
    </left>

    <center>
        <StackPane fx:id="panesContainer" prefHeight="157.0" prefWidth="1060.0" />
    </center>
</BorderPane>
