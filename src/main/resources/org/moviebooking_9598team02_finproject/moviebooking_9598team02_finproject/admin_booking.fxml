<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #1A1A1A;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.moviebooking_9598team02_finproject.moviebooking_9598team02_finproject.Admin.AdminBase"> <top>
    <HBox alignment="CENTER_LEFT" prefHeight="60.0" spacing="20.0" style="-fx-background-color: #000000; -fx-padding: 0 20 0 20;"> <Label style="-fx-text-fill: #FFC72C;" text="FILMBOOK | Admin"> <font><Font size="24.0" /></font>
    </Label>
        <Region HBox.hgrow="ALWAYS" />
        <Label style="-fx-text-fill: #FFFFFF;" text="Admin Name | Logout"> <font><Font size="14.0" /></font>
        </Label>
    </HBox>
</top>

    <left>
        <VBox prefWidth="220.0" spacing="10.0" style="-fx-background-color: #000000; -fx-border-color: #AAAAAA; -fx-border-width: 0 1 0 0;"> <padding>
            <Insets bottom="20.0" left="10.0" right="10.0" top="20.0" />
        </padding>

            <Label prefWidth="1.7976931348623157E308" style="-fx-text-fill: #FFFFFF; -fx-padding: 8 10; -fx-cursor: hand;" text="DASHBOARD" />

            <Label prefWidth="1.7976931348623157E308" style="-fx-text-fill: #FFFFFF; -fx-padding: 8 10; -fx-cursor: hand;" text="MOVIE MANAGEMENT" />

            <Label prefWidth="1.7976931348623157E308" style="-fx-text-fill: #FFFFFF; -fx-padding: 8 10; -fx-cursor: hand;" text="SHOWTIME SCHEDULING" />

            <Label prefWidth="1.7976931348623157E308" style="-fx-text-fill: #FFC72C; -fx-background-color: #1A1A1A; -fx-padding: 8 10; -fx-font-weight: bold; -fx-border-radius: 5; -fx-background-radius: 5;" text="BOOKING MANAGEMENT"> </Label>

            <Label prefWidth="1.7976931348623157E308" style="-fx-text-fill: #FFFFFF; -fx-padding: 8 10; -fx-cursor: hand;" text="CUSTOMER MANAGEMENT" />
            <Label prefWidth="1.7976931348623157E308" style="-fx-text-fill: #FFFFFF; -fx-padding: 8 10; -fx-cursor: hand;" text="REPORTS &amp; ANALYTICS" />
        </VBox>
    </left>

    <center>
        <VBox spacing="20.0" style="-fx-background-color: #1A1A1A;"> <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
        </padding>

            <Label style="-fx-text-fill: #FFFFFF; -fx-font-weight: bold;" text="Booking Management">
                <font><Font size="22.0" /></font>
            </Label>
            <Label style="-fx-text-fill: #AAAAAA;" text="Search, view, and manage all customer ticket bookings.">
                <font><Font size="14.0" /></font>
            </Label>

            <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-padding: 15; -fx-background-color: #2e2e2e; -fx-background-radius: 8;">
                <TextField prefWidth="400.0" promptText="Search by Booking ID, Customer Name, or Phone..." style="-fx-background-color: #404040; -fx-text-fill: #FFFFFF; -fx-prompt-text-fill: #AAAAAA;" />

                <ComboBox promptText="Filter by Status" style="-fx-background-color: #404040; -fx-prompt-text-fill: #AAAAAA;">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="All" />
                            <String fx:value="Confirmed" />
                            <String fx:value="Pending" />
                            <String fx:value="Cancelled" />
                        </FXCollections>
                    </items>
                </ComboBox>

                <DatePicker promptText="Filter by Date" style="-fx-background-color: #404040; -fx-prompt-text-fill: #AAAAAA;" />

                <Button style="-fx-background-color: #FFC72C; -fx-text-fill: #000000; -fx-font-weight: bold; -fx-background-radius: 5;" text="Search" />
                <Region HBox.hgrow="ALWAYS" />
                <Button style="-fx-background-color: #00A693; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-background-radius: 5;" text="Export Bookings" /> </HBox>

            <TableView style="-fx-background-color: #2e2e2e; -fx-background-radius: 8;" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn prefWidth="100" text="Booking ID" />
                    <TableColumn prefWidth="180" text="Customer Name" />
                    <TableColumn prefWidth="250" text="Movie / Showtime" />
                    <TableColumn prefWidth="100" text="Seats" />
                    <TableColumn prefWidth="120" text="Total Price" />
                    <TableColumn prefWidth="100" text="Status" />
                    <TableColumn prefWidth="150" text="Actions" />
                </columns>
                <placeholder>
                    <Label style="-fx-text-fill: #AAAAAA;" text="No current bookings match your search criteria." />
                </placeholder>
            </TableView>

        </VBox>
    </center>

</BorderPane>
