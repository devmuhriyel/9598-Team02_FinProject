<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="720.0" prefWidth="1080.0" style="-fx-background-color: #292929;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.moviebooking_9598team02_finproject.moviebooking_9598team02_finproject.Client_Java.Admin_Side.PaymentMVCs.AdminPaymentView">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="80.0" spacing="20.0" style="-fx-padding: 20;">
            <Label text="Payment Verification" textFill="WHITE">
                <font><Font name="SansSerif Bold" size="24.0" /></font>
            </Label>
            <Label fx:id="lblStatus" text="Ready" textFill="#bbbbbb">
                <font><Font name="SansSerif Italic" size="14.0" /></font>
            </Label>
        </HBox>
    </top>

    <center>
        <TableView fx:id="paymentTable" style="-fx-background-color: #333333; -fx-base: #333333; -fx-control-inner-background: #333333; -fx-text-fill: white;">
            <columns>
                <TableColumn fx:id="colId" prefWidth="80.0" text="Pay ID" />
                <TableColumn fx:id="colBookingId" prefWidth="100.0" text="Booking ID" />
                <TableColumn fx:id="colAmount" prefWidth="100.0" text="Amount" />
                <TableColumn fx:id="colMethod" prefWidth="120.0" text="Method" />
                <TableColumn fx:id="colTxnId" prefWidth="150.0" text="Transaction Ref" />
                <TableColumn fx:id="colDate" prefWidth="150.0" text="Date" />
                <TableColumn fx:id="colStatus" prefWidth="120.0" text="Status" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <BorderPane.margin>
                <Insets bottom="20.0" left="20.0" right="20.0" />
            </BorderPane.margin>
        </TableView>
    </center>

    <right>
        <VBox alignment="TOP_CENTER" prefWidth="250.0" spacing="15.0" style="-fx-background-color: #1A1A1A; -fx-padding: 20;">
            <Label text="Actions" textFill="#ff2525">
                <font><Font name="SansSerif Bold" size="18.0" /></font>
            </Label>

            <Label text="Select a Pending Payment to verify:" textFill="WHITE" wrapText="true" />

            <Button fx:id="btnMarkReceived" maxWidth="1.7976931348623157E308" mnemonicParsing="false" style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="MARK AS RECEIVED">
                <padding><Insets bottom="10" top="10" /></padding>
            </Button>

            <Button fx:id="btnMarkFailed" maxWidth="1.7976931348623157E308" mnemonicParsing="false" style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="DID NOT RECEIVE">
                <padding><Insets bottom="10" top="10" /></padding>
            </Button>

            <Button fx:id="btnRefresh" maxWidth="1.7976931348623157E308" mnemonicParsing="false" style="-fx-background-color: #444444; -fx-text-fill: white; -fx-cursor: hand;" text="Refresh List">
                <padding><Insets bottom="10" top="10" /></padding>
            </Button>
        </VBox>
    </right>

</BorderPane>