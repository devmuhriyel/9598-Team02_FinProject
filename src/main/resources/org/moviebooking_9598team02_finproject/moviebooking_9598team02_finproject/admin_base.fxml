                </HBox>
                <TableView style="-fx-background-color: #2e2e2e; -fx-background-radius: 8;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn prefWidth="100" text="Customer ID" />
                        <TableColumn prefWidth="180" text="Name" />
                        <TableColumn prefWidth="250" text="Email" />
                        <TableColumn prefWidth="120" text="Phone" />
                        <TableColumn prefWidth="120" text="Total Bookings" />
                        <TableColumn prefWidth="100" text="Status" />
                        <TableColumn prefWidth="150" text="Actions" />
                    </columns>
                    <placeholder>
                        <Label style="-fx-text-fill: #AAAAAA;" text="No registered customers found." />
                    </placeholder>
                </TableView>
            </VBox>

