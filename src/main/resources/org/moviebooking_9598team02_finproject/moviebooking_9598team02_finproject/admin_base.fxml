                        <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-padding: 15; -fx-background-color: #2e2e2e; -fx-background-radius: 8;">
                            <Label style="-fx-text-fill: #FFFFFF;" text="Time Period:" />
                            <ComboBox promptText="Select Preset" style="-fx-background-color: #404040; -fx-prompt-text-fill: #AAAAAA;">
