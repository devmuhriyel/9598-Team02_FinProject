            <ScrollPane fx:id="movieView" fitToWidth="true" style="-fx-background-color: #1A1A1A; -fx-border-insets: 0; -fx-padding: 0;" visible="false">
                <content>
                    <VBox spacing="20.0" style="-fx-background-color: #1A1A1A;">
                        <padding>
                            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                        </padding>
                        <Label style="-fx-text-fill: #FFFFFF; -fx-font-weight: bold;" text="Add/Edit Movie Details">
                            <font><Font size="22.0" /></font>
                        </Label>
                        <Label style="-fx-text-fill: #AAAAAA;" text="Enter or modify the information for the new cinema release.">
                            <font><Font size="14.0" /></font>
                        </Label>
                        <GridPane hgap="20.0" style="-fx-padding: 20; -fx-background-color: #2e2e2e; -fx-background-radius: 8;" vgap="15.0">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="20" />
                                <ColumnConstraints percentWidth="80" />
                            </columnConstraints>
                            <Label style="-fx-text-fill: #FFFFFF;" text="Movie Title:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                            <TextField promptText="e.g., The Midnight Rider" style="-fx-background-color: #404040; -fx-text-fill: #FFFFFF; -fx-prompt-text-fill: #AAAAAA;" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                            <Label style="-fx-text-fill: #FFFFFF;" text="Genre:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                            <ComboBox prefWidth="250.0" promptText="Select Genre" style="-fx-background-color: #404040; -fx-prompt-text-fill: #AAAAAA;" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                            <Label style="-fx-text-fill: #FFFFFF;" text="Duration (min):" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                            <TextField promptText="e.g., 120" style="-fx-background-color: #404040; -fx-text-fill: #FFFFFF; -fx-prompt-text-fill: #AAAAAA;" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                            <Label style="-fx-text-fill: #FFFFFF;" text="Release Date:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                            <DatePicker style="-fx-background-color: #404040; -fx-prompt-text-fill: #AAAAAA;" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                            <Label style="-fx-text-fill: #FFFFFF;" text="Status:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                            <ComboBox prefWidth="250.0" promptText="Select Status (e.g., Active, Coming Soon)" style="-fx-background-color: #404040; -fx-prompt-text-fill: #AAAAAA;" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                            <Label style="-fx-text-fill: #FFFFFF;" text="Synopsis:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                            <TextArea prefHeight="100.0" promptText="Briefly describe the movie plot and highlights..." style="-fx-background-color: #404040; -fx-text-fill: #FFFFFF; -fx-prompt-text-fill: #AAAAAA;" GridPane.columnIndex="1" GridPane.rowIndex="5" VBox.vgrow="ALWAYS" />
                            <Label style="-fx-text-fill: #FFFFFF;" text="Poster Image:" GridPane.columnIndex="0" GridPane.rowIndex="6" />
                            <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="6">
                                <TextField editable="false" promptText="No file selected..." style="-fx-background-color: #404040; -fx-text-fill: #FFFFFF; -fx-prompt-text-fill: #AAAAAA;" HBox.hgrow="ALWAYS" />
                                <Button style="-fx-background-color: #FFC72C; -fx-text-fill: #000000; -fx-font-weight: bold; -fx-background-radius: 5;" text="Browse..." />
                            </HBox>
                            <HBox alignment="CENTER_RIGHT" spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="7">
                                <Button onAction="#handleCancel" style="-fx-background-color: #AAAAAA; -fx-text-fill: #000000; -fx-font-weight: bold; -fx-padding: 8 20; -fx-background-radius: 5;" text="Cancel" />
                                <Button onAction="#handleSaveMovie" style="-fx-background-color: #FF0000; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-padding: 8 20; -fx-background-radius: 5;" text="Save Movie" />
                            </HBox>
                            <rowConstraints>
                                <RowConstraints />
                                <RowConstraints />
                                <RowConstraints />
                                <RowConstraints />
                                <RowConstraints />
                                <RowConstraints />
                                <RowConstraints />
                                <RowConstraints />
                            </rowConstraints>
                        </GridPane>
                    </VBox>
                </content>
            </ScrollPane>

            <VBox fx:id="showtimeView" spacing="20.0" style="-fx-background-color: #1A1A1A;" visible="false">
                <padding>
