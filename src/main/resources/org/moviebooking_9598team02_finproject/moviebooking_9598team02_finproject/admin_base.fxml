                                <Label style="-fx-text-fill: #FFFFFF; -fx-font-weight: bold;" text="Key Revenue Metrics">
                                    <font><Font size="16.0" /></font>
                                </Label>
                                <Label style="-fx-text-fill: #FFFFFF;" text="Total Revenue: P25,480.00" />
                                <Label style="-fx-text-fill: #FFFFFF;" text="Avg. Ticket Price: P12.50" />
                                <Label style="-fx-text-fill: #FFFFFF;" text="Total Tickets Sold: 2,038" />
                                <Label style="-fx-text-fill: #FF0000;" text="Refunds Processed: 15" />
                            </VBox>
                            <VBox spacing="10.0" style="-fx-background-color: #2e2e2e; -fx-background-radius: 8; -fx-padding: 20;" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="1">
                                <Label style="-fx-text-fill: #FFFFFF; -fx-font-weight: bold;" text="Top 5 Performing Movies (by Tickets Sold)">
                                    <font><Font size="16.0" /></font>
                                </Label>
