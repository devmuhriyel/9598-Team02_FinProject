                <GridPane hgap="20.0" style="-fx-padding: 20; -fx-background-color: #2e2e2e; -fx-background-radius: 8;" vgap="15.0">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="20" />
                        <ColumnConstraints percentWidth="30" />
                        <ColumnConstraints percentWidth="20" />
                        <ColumnConstraints percentWidth="30" />
                    </columnConstraints>
                    <Label style="-fx-text-fill: #FFFFFF;" text="Movie:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <ComboBox prefWidth="1.7976931348623157E308" promptText="Select Movie" style="-fx-background-color: #404040; -fx-prompt-text-fill: #AAAAAA;" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                    <Label style="-fx-text-fill: #FFFFFF;" text="Auditorium/Screen:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                    <ComboBox prefWidth="1.7976931348623157E308" promptText="Select Screen" style="-fx-background-color: #404040; -fx-prompt-text-fill: #AAAAAA;" GridPane.columnIndex="3" GridPane.rowIndex="0" />
                    <Label style="-fx-text-fill: #FFFFFF;" text="Show Date:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <DatePicker style="-fx-background-color: #404040; -fx-prompt-text-fill: #AAAAAA;" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                    <Label style="-fx-text-fill: #FFFFFF;" text="Start Time:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                    <TextField promptText="HH:MM (e.g., 18:30)" style="-fx-background-color: #404040; -fx-text-fill: #FFFFFF; -fx-prompt-text-fill: #AAAAAA;" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                    <HBox alignment="CENTER_RIGHT" spacing="10.0" GridPane.columnIndex="3" GridPane.rowIndex="2">
                        <Button onAction="#handleAddShowtime" style="-fx-background-color: #00CC66; -fx-text-fill: #000000; -fx-font-weight: bold; -fx-padding: 8 20; -fx-background-radius: 5;" text="Add Showtime" />
                    </HBox>
                    <rowConstraints>
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                    </rowConstraints>
                </GridPane>
