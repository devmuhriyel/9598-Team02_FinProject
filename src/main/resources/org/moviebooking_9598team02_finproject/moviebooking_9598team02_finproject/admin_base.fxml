                <TableView prefHeight="400.0" style="-fx-background-color: #2e2e2e; -fx-background-radius: 8;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn prefWidth="250" text="Movie" />
                        <TableColumn prefWidth="100" text="Screen" />
                        <TableColumn prefWidth="120" text="Date" />
                        <TableColumn prefWidth="100" text="Time" />
                        <TableColumn prefWidth="100" text="End Time" />
                        <TableColumn prefWidth="100" text="Status" />
                        <TableColumn prefWidth="150" text="Actions" />
                    </columns>
                    <placeholder>
                        <Label style="-fx-text-fill: #AAAAAA;" text="No showtimes have been scheduled yet." />
                    </placeholder>
                </TableView>
            </VBox>

            <VBox fx:id="bookingView" spacing="20.0" style="-fx-background-color: #1A1A1A;" visible="false">
                <padding>
                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
