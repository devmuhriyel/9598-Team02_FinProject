<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #292929;"
            xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.moviebooking_9598team02_finproject.moviebooking_9598team02_finproject.Admin.AdminBase">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="60.0" spacing="20.0" style="-fx-background-color: #000000; -fx-padding: 0 20 0 20;">
            <Label style="-fx-text-fill: #ff2525; -fx-font-weight: bold;"
                   text="FILMBOOK | Admin">
                <font><Font name="SansSerif Bold" size="24.0" /></font>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
            <Label style="-fx-text-fill: #FFFFFF;"
                   text="Admin Name | Logout">
                <font><Font name="SansSerif Regular" size="14.0" /></font>
            </Label>
        </HBox>
    </top>

    <left>
        <VBox prefWidth="220.0" spacing="10.0" style="-fx-background-color: #1A1A1A; -fx-border-color: #404040; -fx-border-width: 0 1 0 0;">
            <padding>
                <Insets bottom="20.0"
                        left="10.0" right="10.0" top="20.0" />
            </padding>

            <Label fx:id="navDashboard" prefWidth="1.7976931348623157E308" style="-fx-text-fill: #FFFFFF; -fx-background-color: #ff2525; -fx-padding: 8 10; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;"
                   text="DASHBOARD" />

            <Label fx:id="navMovie" prefWidth="1.7976931348623157E308" style="-fx-text-fill: #FFFFFF; -fx-padding: 8 10; -fx-cursor: hand;"
                   text="MOVIE MANAGEMENT" />

            <Label fx:id="navShowtime" prefWidth="1.7976931348623157E308" style="-fx-text-fill: #FFFFFF; -fx-padding: 8 10; -fx-cursor: hand;"
                   text="SEAT MANAGEMENT" />

            <Label fx:id="navBooking" prefWidth="1.7976931348623157E308" style="-fx-text-fill: #FFFFFF; -fx-padding: 8 10; -fx-cursor: hand;"
                   text="BOOKING MANAGEMENT" />

            <Label fx:id="navCustomer" prefWidth="1.7976931348623157E308" style="-fx-text-fill: #FFFFFF; -fx-padding: 8 10; -fx-cursor: hand;"
                   text="CUSTOMER MANAGEMENT" />

        </VBox>
    </left>

    <center>
        <StackPane fx:id="rootContentStack">

            <VBox fx:id="dashboardView" spacing="20.0" style="-fx-background-color: #292929;">
                <padding>
                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />

                </padding>
                <Label style="-fx-text-fill: #FFFFFF; -fx-font-weight: bold;"
                       text="Admin Dashboard Overview">
                    <font><Font name="SansSerif Bold" size="22.0" /></font>
                </Label>
                <Label style="-fx-text-fill: #AAAAAA;"
                       text="Quick summary of key operational metrics and cinema status.">
                    <font><Font name="SansSerif Regular" size="14.0" /></font>
                </Label>
                <GridPane hgap="20.0" vgap="20.0">
                    <columnConstraints>

                        <ColumnConstraints percentWidth="25" />
                        <ColumnConstraints percentWidth="25" />
                        <ColumnConstraints percentWidth="25" />
                        <ColumnConstraints percentWidth="25" />

                    </columnConstraints>

                    <VBox style="-fx-background-color: #1A1A1A; -fx-background-radius: 8; -fx-padding: 15;"
                          GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label style="-fx-text-fill: #AAAAAA; -fx-font-size: 14px;"
                               text="Total Today's Sales" />
                        <Label style="-fx-text-fill: #FFFFFF; -fx-font-weight: bold;"
                               text="P1,250.00">
                            <font><Font name="SansSerif Bold" size="28.0" /></font>
                        </Label>
                        <Label style="-fx-text-fill: #00CC66; -fx-font-size: 12px;"
                               text="+15% vs Yesterday" />
                    </VBox>
                    <VBox style="-fx-background-color: #1A1A1A; -fx-background-radius: 8; -fx-padding: 15;"
                          GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label style="-fx-text-fill: #AAAAAA; -fx-font-size: 14px;"
                               text="Tickets Sold Today" />
                        <Label style="-fx-text-fill: #FFFFFF; -fx-font-weight: bold;"
                               text="428">
                            <font><Font name="SansSerif Bold" size="28.0" /></font>
                        </Label>
                        <Label style="-fx-text-fill: #ff2525; -fx-font-size: 12px;"
                               text="6 active showtimes" />
                    </VBox>
                    <VBox style="-fx-background-color: #1A1A1A; -fx-background-radius: 8; -fx-padding: 15;"
                          GridPane.columnIndex="2" GridPane.rowIndex="0">
                        <Label style="-fx-text-fill: #AAAAAA; -fx-font-size: 14px;"
                               text="Active Movies" />
                        <Label style="-fx-text-fill: #FFFFFF; -fx-font-weight: bold;"
                               text="12">
                            <font><Font name="SansSerif Bold" size="28.0" /></font>
                        </Label>
                        <Label style="-fx-text-fill: #FFFFFF; -fx-font-size: 12px;"
                               text="4 coming soon" />
                    </VBox>
                    <VBox style="-fx-background-color: #1A1A1A; -fx-background-radius: 8; -fx-padding: 15;"
                          GridPane.columnIndex="3" GridPane.rowIndex="0">
                        <Label style="-fx-text-fill: #AAAAAA; -fx-font-size: 14px;"
                               text="New Customers (Week)" />
                        <Label style="-fx-text-fill: #FFFFFF; -fx-font-weight: bold;"
                               text="94">
                            <font><Font name="SansSerif Bold" size="28.0" /></font>
                        </Label>
                        <Label style="-fx-text-fill: #FFFFFF; -fx-font-size: 12px;"
                               text="18 logged in now" />
                    </VBox>
                    <rowConstraints>
                        <RowConstraints />
                    </rowConstraints>

                </GridPane>

                <Label style="-fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-padding: 20 0 0 0;"
                       text="Sales &amp; Performance Analytics">
                    <font><Font name="SansSerif Bold" size="20.0" /></font>
                </Label>
                <Label style="-fx-text-fill: #AAAAAA;"
                       text="Detailed insights on revenue and movie performance.">
                    <font><Font name="SansSerif Regular" size="14.0" /></font>
                </Label>
                <GridPane hgap="20.0" vgap="20.0">
                    <columnConstraints>

                        <ColumnConstraints percentWidth="60" />
                        <ColumnConstraints percentWidth="40" />
                    </columnConstraints>

                    <VBox spacing="10.0" style="-fx-background-color: #1A1A1A; -fx-background-radius: 8; -fx-padding: 20;"
                          GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label style="-fx-text-fill: #FFFFFF; -fx-font-weight: bold;"
                               text="Sales Performance Chart">
                            <font><Font name="SansSerif Bold" size="16.0" /></font>
                        </Label>
                        <StackPane prefHeight="250.0" style="-fx-background-color: #404040;">

                            <Label style="-fx-text-fill: #AAAAAA;"
                                   text="[Placeholder: Sales Revenue Line Chart]" />
                        </StackPane>
                    </VBox>

                    <VBox spacing="10.0" style="-fx-background-color: #1A1A1A; -fx-background-radius: 8; -fx-padding: 20;"
                          GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label style="-fx-text-fill: #FFFFFF; -fx-font-weight: bold;"
                               text="Key Revenue Metrics">
                            <font><Font name="SansSerif Bold" size="16.0" /></font>
                        </Label>
                        <Label style="-fx-text-fill: #FFFFFF;"
                               text="Total Revenue: P25,480.00" />
                        <Label style="-fx-text-fill: #FFFFFF;"
                               text="Avg. Ticket Price: P12.50" />
                        <Label style="-fx-text-fill: #FFFFFF;"
                               text="Total Tickets Sold: 2,038" />
                        <Label style="-fx-text-fill: #ff2525;"
                               text="Refunds Processed: 15" />
                    </VBox>

                    <VBox spacing="10.0" style="-fx-background-color: #1A1A1A; -fx-background-radius: 8; -fx-padding: 20;"
                          GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="1">
                        <Label style="-fx-text-fill: #FFFFFF; -fx-font-weight: bold;"
                               text="Top 5 Performing Movies (by Tickets Sold)">
                            <font><Font name="SansSerif Bold" size="16.0" /></font>
                        </Label>
                        <TableView prefHeight="150.0">

                            <columns>
                                <TableColumn prefWidth="50" text="Rank" />
                                <TableColumn prefWidth="350" text="Movie Title" />

                                <TableColumn prefWidth="150" text="Tickets Sold" />
                                <TableColumn prefWidth="150" text="Total Revenue" />
                            </columns>

                            <placeholder>
                                <Label style="-fx-text-fill: #AAAAAA;"
                                       text="Run report to view data." />
                            </placeholder>
                        </TableView>
                    </VBox>
                    <rowConstraints>

                        <RowConstraints />
                        <RowConstraints />
                    </rowConstraints>
                </GridPane>
            </VBox>

            <ScrollPane fx:id="movieView" fitToWidth="true" style="-fx-background-color: #292929; -fx-border-insets: 0; -fx-padding: 0;"
                        visible="false">
                <content>
                    <VBox prefHeight="877.0" prefWidth="1046.0" spacing="20.0" style="-fx-background-color: #292929;">
                        <padding>
                            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />

                        </padding>
                        <Label style="-fx-text-fill: #FFFFFF; -fx-font-weight: bold;"
                               text="Add/Edit Movie Details">
                            <font><Font name="SansSerif Bold" size="22.0" /></font>
                        </Label>
                        <Label style="-fx-text-fill: #AAAAAA;"
                               text="Enter or modify the information for the new cinema release.">
                            <font><Font name="SansSerif Regular" size="14.0" /></font>
                        </Label>
                        <GridPane hgap="20.0" style="-fx-padding: 20; -fx-background-color: #1A1A1A; -fx-background-radius: 8;"
                                  vgap="15.0">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="20" />
                                <ColumnConstraints percentWidth="80" />

                            </columnConstraints>
                            <Label style="-fx-text-fill: #FFFFFF;"
                                   text="Movie Title:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                            <TextField promptText="e.g., The Midnight Rider" style="-fx-background-color: #404040; -fx-text-fill: #FFFFFF; -fx-prompt-text-fill: #AAAAAA;"
                                       GridPane.columnIndex="1" GridPane.rowIndex="0" />
                            <Label style="-fx-text-fill: #FFFFFF;"
                                   text="Genre:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                            <ComboBox prefWidth="250.0" promptText="Select Genre" style="-fx-background-color: #404040; -fx-prompt-text-fill: #AAAAAA;"
                                      GridPane.columnIndex="1" GridPane.rowIndex="1" />
                            <Label style="-fx-text-fill: #FFFFFF;"
                                   text="Duration (min):" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                            <TextField promptText="e.g., 120" style="-fx-background-color: #404040; -fx-text-fill: #FFFFFF; -fx-prompt-text-fill: #AAAAAA;"
                                       GridPane.columnIndex="1" GridPane.rowIndex="2" />
                            <Label style="-fx-text-fill: #FFFFFF;"
                                   text="Release Date:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                            <DatePicker style="-fx-background-color: #404040; -fx-prompt-text-fill: #AAAAAA;"
                                        GridPane.columnIndex="1" GridPane.rowIndex="3" />
                            <Label style="-fx-text-fill: #FFFFFF;"
                                   text="Status:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                            <ComboBox prefWidth="250.0" promptText="Select Status (e.g., Active, Coming Soon)" style="-fx-background-color: #404040; -fx-prompt-text-fill: #AAAAAA;"
                                      GridPane.columnIndex="1" GridPane.rowIndex="4" />
                            <Label style="-fx-text-fill: #FFFFFF;"
                                   text="Synopsis:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                            <TextArea prefHeight="100.0" promptText="Briefly describe the movie plot and highlights..." style="-fx-background-color: #404040; -fx-text-fill: #FFFFFF; -fx-prompt-text-fill: #AAAAAA;"
                                      GridPane.columnIndex="1" GridPane.rowIndex="5" VBox.vgrow="ALWAYS" />
                            <Label style="-fx-text-fill: #FFFFFF;"
                                   text="Poster Image:" GridPane.columnIndex="0" GridPane.rowIndex="6" />
                            <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="6">
                                <TextField editable="false" promptText="No file selected..." style="-fx-background-color: #404040; -fx-text-fill: #FFFFFF; -fx-prompt-text-fill: #AAAAAA;"
                                           HBox.hgrow="ALWAYS" />
                                <Button prefHeight="26.0" prefWidth="182.0" style="-fx-background-color: #ff2525; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-background-radius: 5;"
                                        text="Browse..." />
                            </HBox>
                            <HBox alignment="CENTER_RIGHT" spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="7">
                                <Button onAction="#handleCancel" style="-fx-background-color: #AAAAAA; -fx-text-fill: #000000; -fx-font-weight:
                                 bold; -fx-padding: 8 20; -fx-background-radius: 5;"
                                        text="Cancel" />
                                <Button onAction="#handleSaveMovie" style="-fx-background-color: #ff2525; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-padding: 8 20; -fx-background-radius: 5;"
                                        text="Save Movie" />
                            </HBox>
                            <rowConstraints>
                                <RowConstraints />

                                <RowConstraints />
                                <RowConstraints />
                                <RowConstraints />

                                <RowConstraints />
                                <RowConstraints />
                                <RowConstraints />

                                <RowConstraints />
                            </rowConstraints>
                        </GridPane>
                    </VBox>

                </content>
            </ScrollPane>

            <VBox fx:id="seatView" spacing="20.0" style="-fx-background-color: #292929;"
                  visible="false">
                <padding>
                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                </padding>
                <Label style="-fx-text-fill: #FFFFFF; -fx-font-weight: bold;"
                       text="Seat and Auditorium Management">
                    <font><Font name="SansSerif Bold" size="22.0" /></font>
                </Label>
                <Label style="-fx-text-fill: #AAAAAA;"
                       text="Configure auditorium layouts, seat pricing, and VIP sections.">
                    <font><Font name="SansSerif Regular" size="14.0" /></font>
                </Label>
                <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-padding: 15; -fx-background-color: #1A1A1A; -fx-background-radius: 8;">
                    <ComboBox prefWidth="250.0" promptText="Select Auditorium" style="-fx-background-color: #404040; -fx-prompt-text-fill: #AAAAAA;"
                    />
                    <Button style="-fx-background-color: #ff2525; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-background-radius: 5;"
                            text="Load Layout" />
                </HBox>
                <StackPane style="-fx-background-color: #1A1A1A; -fx-background-radius: 8;"
                           VBox.vgrow="ALWAYS">
                    <Label style="-fx-text-fill: #AAAAAA;"
                           text="[Placeholder: Graphical Seat Layout Editor / Table View of Configurations]" />
                </StackPane>
            </VBox>

            <VBox fx:id="bookingView" spacing="20.0" style="-fx-background-color: #292929;"
                  visible="false">
                <padding>
                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                </padding>
                <Label style="-fx-text-fill: #FFFFFF; -fx-font-weight: bold;"
                       text="Booking Management">
                    <font><Font name="SansSerif Bold" size="22.0" /></font>
                </Label>
                <Label style="-fx-text-fill: #AAAAAA;"
                       text="Search, view, and manage all customer ticket bookings.">
                    <font><Font name="SansSerif Regular" size="14.0" /></font>
                </Label>
                <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-padding: 15; -fx-background-color: #1A1A1A; -fx-background-radius: 8;">
                    <TextField prefWidth="400.0" promptText="Search by Booking ID, Customer Name, or
Phone..." style="-fx-background-color:                         #404040; -fx-text-fill: #FFFFFF; -fx-prompt-text-fill: #AAAAAA;"
                    />
                    <ComboBox promptText="Filter by Status" style="-fx-background-color: #404040; -fx-prompt-text-fill: #AAAAAA;">
                        <items>
                            <FXCollections fx:factory="observableArrayList">

                                <String fx:value="All" />
                                <String fx:value="Confirmed" />
                                <String fx:value="Pending" />

                                <String fx:value="Cancelled" />
                            </FXCollections>
                        </items>
                    </ComboBox>

                    <DatePicker promptText="Filter by Date" style="-fx-background-color: #404040; -fx-prompt-text-fill: #AAAAAA;"
                    />
                    <Button style="-fx-background-color: #ff2525; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-background-radius: 5;"
                            text="Search" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button style="-fx-background-color: #00A693; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-background-radius: 5;"
                            text="Export Bookings" />
                </HBox>
                <TableView style="-fx-background-color: #1A1A1A; -fx-background-radius: 8;"
                           VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn prefWidth="100" text="Booking ID" />
                        <TableColumn prefWidth="180" text="Customer Name" />

                        <TableColumn prefWidth="250" text="Movie / Showtime" />
                        <TableColumn prefWidth="100" text="Seats" />
                        <TableColumn prefWidth="120" text="Total Price" />
                        <TableColumn prefWidth="100" text="Status" />

                        <TableColumn prefWidth="150" text="Actions" />
                    </columns>
                    <placeholder>
                        <Label style="-fx-text-fill: #AAAAAA;"
                               text="No current bookings match your search criteria." />
                    </placeholder>
                </TableView>
            </VBox>

            <VBox fx:id="customerView" spacing="20.0" style="-fx-background-color: #292929;"
                  visible="false">
                <padding>
                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                </padding>
                <Label style="-fx-text-fill: #FFFFFF; -fx-font-weight: bold;"
                       text="Customer Account Management">
                    <font><Font name="SansSerif Bold" size="22.0" /></font>
                </Label>
                <Label style="-fx-text-fill: #AAAAAA;"
                       text="View, search, and edit registered customer accounts and data.">
                    <font><Font name="SansSerif Regular" size="14.0" /></font>
                </Label>
                <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-padding: 15; -fx-background-color: #1A1A1A; -fx-background-radius: 8;">
                    <TextField prefWidth="350.0" promptText="Search by Name, Email, or Customer
ID..." style="-fx-background-color:                         #404040; -fx-text-fill: #FFFFFF; -fx-prompt-text-fill: #AAAAAA;"
                    />
                    <ComboBox promptText="Filter by Status" style="-fx-background-color: #404040; -fx-prompt-text-fill: #AAAAAA;">
                        <items>
                            <FXCollections fx:factory="observableArrayList">

                                <String fx:value="All" />
                                <String fx:value="Active" />
                                <String fx:value="Suspended" />

                            </FXCollections>
                        </items>
                    </ComboBox>
                    <Button style="-fx-background-color: #ff2525; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-background-radius: 5;"
                            text="Search" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button onAction="#handleAddCustomer" style="-fx-background-color: #00CC66; -fx-text-fill: #000000; -fx-font-weight: bold; -fx-background-radius: 5;"
                            text="+ Add New Customer" />
                </HBox>
                <TableView style="-fx-background-color: #1A1A1A; -fx-background-radius: 8;"
                           VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn prefWidth="100" text="Customer ID" />
                        <TableColumn prefWidth="180" text="Name" />
                        <TableColumn
                                prefWidth="250" text="Email" />
                        <TableColumn prefWidth="120" text="Phone" />
                        <TableColumn prefWidth="120" text="Total Bookings" />
                        <TableColumn prefWidth="100" text="Status" />

                        <TableColumn prefWidth="150" text="Actions" />
                    </columns>
                    <placeholder>
                        <Label style="-fx-text-fill: #AAAAAA;"
                               text="No registered customers found." />
                    </placeholder>
                </TableView>
            </VBox>

        </StackPane>
    </center>
</BorderPane>