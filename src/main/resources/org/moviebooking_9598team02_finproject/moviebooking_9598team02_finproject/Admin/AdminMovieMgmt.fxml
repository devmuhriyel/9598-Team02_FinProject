<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #292929;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.moviebooking_9598team02_finproject.moviebooking_9598team02_finproject.Client_Java.Admin_Side.MovieMVCs.MovieView">
    <center>
        <StackPane fx:id="rootContentStack">

            <!-- MAIN GRID VIEW -->
            <VBox fx:id="movieView" spacing="20.0" style="-fx-background-color: #292929;">
                <padding>
                    <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
                </padding>

                <!-- Header Section -->
                <VBox spacing="15.0" style="-fx-background-color: #1A1A1A; -fx-padding: 20; -fx-background-radius: 5;">
                    <Label style="-fx-text-fill: #FFFFFF; -fx-font-size: 16px; -fx-font-weight: bold;" text="FILMBOOK MOVIES">
                        <font>
                            <Font name="SansSerif Bold" size="16.0" />
                        </font>
                    </Label>

                    <!-- Search and Actions Bar -->
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <TextField fx:id="searchField" prefWidth="400.0" promptText="Search Movies by title" style="-fx-background-color: #292929; -fx-border-color: #ff2525; -fx-border-width: 2; -fx-border-radius: 5; -fx-padding: 10 15; -fx-font-size: 14px; -fx-text-fill: #FFFFFF; -fx-prompt-text-fill: #888888;" HBox.hgrow="ALWAYS">
                            <font>
                                <Font name="SansSerif Regular" size="14.0" />
                            </font>
                        </TextField>
                        <Button fx:id="btnSearch" style="-fx-background-color: #1A1A1A; -fx-border-color: #ff2525; -fx-border-width: 2; -fx-border-radius: 5; -fx-padding: 10 18; -fx-font-size: 16px; -fx-cursor: hand; -fx-text-fill: #FFFFFF;" text="🔍" />
                        <Button fx:id="btnFilter" style="-fx-background-color: #1A1A1A; -fx-border-color: #ff2525; -fx-border-width: 2; -fx-border-radius: 5; -fx-padding: 10 18; -fx-font-size: 16px; -fx-cursor: hand; -fx-text-fill: #FFFFFF;" text="☰" />
                        <Button fx:id="btnAddNewMovie" style="-fx-background-color: #1A1A1A; -fx-border-color: #ff2525; -fx-border-width: 2; -fx-border-radius: 5; -fx-padding: 10 25; -fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #ff2525; -fx-cursor: hand;" text="Add">
                            <font>
                                <Font name="SansSerif Bold" size="14.0" />
                            </font>
                        </Button>
                        <Button fx:id="btnEdit" style="-fx-background-color: #1A1A1A; -fx-border-color: #ff2525; -fx-border-width: 2; -fx-border-radius: 5; -fx-padding: 10 25; -fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #ff2525; -fx-cursor: hand;" text="Edit">
                            <font>
                                <Font name="SansSerif Bold" size="14.0" />
                            </font>
                        </Button>
                    </HBox>
                </VBox>

                <!-- Status Message -->
                <Label fx:id="statusMessageLabel" maxWidth="1.7976931348623157E308" style="-fx-padding: 12; -fx-background-color: #1A1A1A; -fx-background-radius: 5; -fx-text-fill: #FFFFFF; -fx-font-size: 13px;" text=" " visible="false">
                    <font>
                        <Font name="SansSerif Regular" size="13.0" />
                    </font>
                </Label>

                <!-- Movie Cards Grid with Pagination -->
                <ScrollPane fitToHeight="true" fitToWidth="true" style="-fx-background: #292929; -fx-background-color: #292929;" VBox.vgrow="ALWAYS">
                    <VBox spacing="20.0">
                        <GridPane fx:id="movieGridPane" hgap="20.0" vgap="20.0" />

                        <!-- Pagination -->
                        <HBox alignment="CENTER" spacing="15.0" style="-fx-padding: 20 0 0 0;">
                            <Button fx:id="btnPreviousPage" style="-fx-background-color: #1A1A1A; -fx-border-color: #ff2525; -fx-border-width: 2; -fx-border-radius: 5; -fx-padding: 8 15; -fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #ff2525; -fx-cursor: hand;" text="&lt;">
                                <font>
                                    <Font name="SansSerif Bold" size="16.0" />
                                </font>
                            </Button>
                            <Label fx:id="pageLabel" style="-fx-text-fill: #FFFFFF; -fx-font-size: 20px; -fx-font-weight: bold;" text="1">
                                <font>
                                    <Font name="SansSerif Bold" size="20.0" />
                                </font>
                            </Label>
                            <Button fx:id="btnNextPage" style="-fx-background-color: #1A1A1A; -fx-border-color: #ff2525; -fx-border-width: 2; -fx-border-radius: 5; -fx-padding: 8 15; -fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #ff2525; -fx-cursor: hand;" text="&gt;">
                                <font>
                                    <Font name="SansSerif Bold" size="16.0" />
                                </font>
                            </Button>
                        </HBox>
                    </VBox>
                </ScrollPane>
            </VBox>

            <!-- ADD MOVIE VIEW -->
            <VBox fx:id="addMovieView" managed="false" spacing="20.0" style="-fx-background-color: #292929;" visible="false">
                <padding>
                    <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
                </padding>

                <!-- Back Button -->
                <HBox alignment="CENTER_LEFT">
                    <Button fx:id="btnBackToGrid" style="-fx-background-color: transparent; -fx-text-fill: #ff2525; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand; -fx-underline: true;" text="← Back to Movies">
                        <font>
                            <Font name="SansSerif Bold" size="14.0" />
                        </font>
                    </Button>
                </HBox>

                <!-- Add Movie Form -->
                <VBox spacing="20.0" style="-fx-background-color: #1A1A1A; -fx-padding: 30; -fx-background-radius: 5;">

                    <Label style="-fx-text-fill: #FFFFFF; -fx-font-size: 22px; -fx-font-weight: bold;" text="Add New Movie">
                        <font>
                            <Font name="SansSerif Bold" size="22.0" />
                        </font>
                    </Label>

                    <Separator style="-fx-background-color: #404040;" />

                    <VBox spacing="18.0">
                        <!-- Title -->
                        <VBox spacing="6.0">
                            <Label style="-fx-text-fill: #CCCCCC; -fx-font-size: 13px; -fx-font-weight: bold;" text="Movie Title *">
                                <font>
                                    <Font name="SansSerif Bold" size="13.0" />
                                </font>
                            </Label>
                            <TextField fx:id="titleInput" promptText="Enter movie title" style="-fx-background-color: #292929; -fx-text-fill: #FFFFFF; -fx-border-color: #404040; -fx-border-width: 1; -fx-border-radius: 5; -fx-padding: 12 15; -fx-font-size: 14px; -fx-prompt-text-fill: #888888;">
                                <font>
                                    <Font name="SansSerif Regular" size="14.0" />
                                </font>
                            </TextField>
                        </VBox>

                        <!-- Genre and Rating -->
                        <HBox spacing="16.0">
                            <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                <Label style="-fx-text-fill: #CCCCCC; -fx-font-size: 13px; -fx-font-weight: bold;" text="Genre *">
                                    <font>
                                        <Font name="SansSerif Bold" size="13.0" />
                                    </font>
                                </Label>
                                <ComboBox fx:id="genreComboBox" maxWidth="1.7976931348623157E308" promptText="Select genre" style="-fx-background-color: #292929; -fx-border-color: #404040; -fx-border-width: 1; -fx-border-radius: 5;" />
                            </VBox>
                            <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                <Label style="-fx-text-fill: #CCCCCC; -fx-font-size: 13px; -fx-font-weight: bold;" text="Rating *">
                                    <font>
                                        <Font name="SansSerif Bold" size="13.0" />
                                    </font>
                                </Label>
                                <ComboBox fx:id="ratingComboBox" maxWidth="1.7976931348623157E308" promptText="Select rating" style="-fx-background-color: #292929; -fx-border-color: #404040; -fx-border-width: 1; -fx-border-radius: 5;" />
                            </VBox>
                        </HBox>

                        <!-- Duration, Release Date, Status -->
                        <HBox spacing="16.0">
                            <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                <Label style="-fx-text-fill: #CCCCCC; -fx-font-size: 13px; -fx-font-weight: bold;" text="Duration (min)">
                                    <font>
                                        <Font name="SansSerif Bold" size="13.0" />
                                    </font>
                                </Label>
                                <TextField fx:id="durationInput" promptText="120" style="-fx-background-color: #292929; -fx-text-fill: #FFFFFF; -fx-border-color: #404040; -fx-border-width: 1; -fx-border-radius: 5; -fx-padding: 12 15; -fx-font-size: 14px; -fx-prompt-text-fill: #888888;">
                                    <font>
                                        <Font name="SansSerif Regular" size="14.0" />
                                    </font>
                                </TextField>
                            </VBox>
                            <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                <Label style="-fx-text-fill: #CCCCCC; -fx-font-size: 13px; -fx-font-weight: bold;" text="Release Date">
                                    <font>
                                        <Font name="SansSerif Bold" size="13.0" />
                                    </font>
                                </Label>
                                <TextField fx:id="releaseDateInput" promptText="YYYY-MM-DD" style="-fx-background-color: #292929; -fx-text-fill: #FFFFFF; -fx-border-color: #404040; -fx-border-width: 1; -fx-border-radius: 5; -fx-padding: 12 15; -fx-font-size: 14px; -fx-prompt-text-fill: #888888;">
                                    <font>
                                        <Font name="SansSerif Regular" size="14.0" />
                                    </font>
                                </TextField>
                            </VBox>
                            <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                <Label style="-fx-text-fill: #CCCCCC; -fx-font-size: 13px; -fx-font-weight: bold;" text="Status">
                                    <font>
                                        <Font name="SansSerif Bold" size="13.0" />
                                    </font>
                                </Label>
                                <ComboBox fx:id="statusComboBox" maxWidth="1.7976931348623157E308" promptText="Select status" style="-fx-background-color: #292929; -fx-border-color: #404040; -fx-border-width: 1; -fx-border-radius: 5;" />
                            </VBox>
                        </HBox>

                        <!-- Description -->
                        <VBox spacing="6.0">
                            <Label style="-fx-text-fill: #CCCCCC; -fx-font-size: 13px; -fx-font-weight: bold;" text="Description">
                                <font>
                                    <Font name="SansSerif Bold" size="13.0" />
                                </font>
                            </Label>
                            <TextArea fx:id="descriptionInput" prefRowCount="4" promptText="Enter movie description..." style="-fx-control-inner-background: #292929; -fx-text-fill: #FFFFFF; -fx-border-color: #404040; -fx-border-width: 1; -fx-border-radius: 5; -fx-font-size: 14px; -fx-prompt-text-fill: #888888;" wrapText="true">
                                <font>
                                    <Font name="SansSerif Regular" size="14.0" />
                                </font>
                            </TextArea>
                        </VBox>

                        <!-- Poster URL -->
                        <VBox spacing="6.0">
                            <Label style="-fx-text-fill: #CCCCCC; -fx-font-size: 13px; -fx-font-weight: bold;" text="Poster URL">
                                <font>
                                    <Font name="SansSerif Bold" size="13.0" />
                                </font>
                            </Label>
                            <TextField fx:id="posterUrlInput" promptText="https://example.com/poster.jpg" style="-fx-background-color: #292929; -fx-text-fill: #FFFFFF; -fx-border-color: #404040; -fx-border-width: 1; -fx-border-radius: 5; -fx-padding: 12 15; -fx-font-size: 14px; -fx-prompt-text-fill: #888888;">
                                <font>
                                    <Font name="SansSerif Regular" size="14.0" />
                                </font>
                            </TextField>
                        </VBox>

                        <!-- Director and Cast -->
                        <HBox spacing="16.0">
                            <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                <Label style="-fx-text-fill: #CCCCCC; -fx-font-size: 13px; -fx-font-weight: bold;" text="Director">
                                    <font>
                                        <Font name="SansSerif Bold" size="13.0" />
                                    </font>
                                </Label>
                                <TextField fx:id="directorInput" promptText="Director name" style="-fx-background-color: #292929; -fx-text-fill: #FFFFFF; -fx-border-color: #404040; -fx-border-width: 1; -fx-border-radius: 5; -fx-padding: 12 15; -fx-font-size: 14px; -fx-prompt-text-fill: #888888;">
                                    <font>
                                        <Font name="SansSerif Regular" size="14.0" />
                                    </font>
                                </TextField>
                            </VBox>
                            <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                <Label style="-fx-text-fill: #CCCCCC; -fx-font-size: 13px; -fx-font-weight: bold;" text="Cast">
                                    <font>
                                        <Font name="SansSerif Bold" size="13.0" />
                                    </font>
                                </Label>
                                <TextField fx:id="castInput" promptText="Main actors (comma separated)" style="-fx-background-color: #292929; -fx-text-fill: #FFFFFF; -fx-border-color: #404040; -fx-border-width: 1; -fx-border-radius: 5; -fx-padding: 12 15; -fx-font-size: 14px; -fx-prompt-text-fill: #888888;">
                                    <font>
                                        <Font name="SansSerif Regular" size="14.0" />
                                    </font>
                                </TextField>
                            </VBox>
                        </HBox>
                    </VBox>

                    <Separator style="-fx-background-color: #404040;" />

                    <!-- Action Buttons -->
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <Button fx:id="btnSaveMovie" style="-fx-background-color: #ff2525; -fx-text-fill: #FFFFFF; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 32; -fx-background-radius: 5; -fx-cursor: hand;" text="Save Movie">
                            <font>
                                <Font name="SansSerif Bold" size="14.0" />
                            </font>
                        </Button>
                        <Button fx:id="btnClearFields" style="-fx-background-color: #1A1A1A; -fx-border-color: #404040; -fx-border-width: 1; -fx-border-radius: 5; -fx-text-fill: #CCCCCC; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 32; -fx-cursor: hand;" text="Clear">
                            <font>
                                <Font name="SansSerif Bold" size="14.0" />
                            </font>
                        </Button>
                    </HBox>
                </VBox>
            </VBox>

            <!-- EDIT MOVIE VIEW -->
            <VBox fx:id="editMovieView" managed="false" spacing="20.0" style="-fx-background-color: #292929;" visible="false">
                <padding>
                    <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
                </padding>

                <!-- Back Button -->
                <HBox alignment="CENTER_LEFT">
                    <Button fx:id="btnBackToGridFromEdit" style="-fx-background-color: transparent; -fx-text-fill: #ff2525; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand; -fx-underline: true;" text="← Back to Movies">
                        <font>
                            <Font name="SansSerif Bold" size="14.0" />
                        </font>
                    </Button>
                </HBox>

                <!-- Edit Movie Form -->
                <VBox spacing="20.0" style="-fx-background-color: #1A1A1A; -fx-padding: 30; -fx-background-radius: 5;">

                    <HBox alignment="CENTER_LEFT" spacing="15.0">
                        <Label style="-fx-text-fill: #FFFFFF; -fx-font-size: 22px; -fx-font-weight: bold;" text="Edit Movie">
                            <font>
                                <Font name="SansSerif Bold" size="22.0" />
                            </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="currentMovieDetailsLabel" style="-fx-text-fill: #888888; -fx-font-size: 13px;" text="Movie ID: -">
                            <font>
                                <Font name="SansSerif Regular" size="13.0" />
                            </font>
                        </Label>
                    </HBox>

                    <Separator style="-fx-background-color: #404040;" />

                    <Label style="-fx-text-fill: #888888; -fx-font-size: 12px;" text="Edit fields use the same inputs as Add view">
                        <font>
                            <Font name="SansSerif Regular" size="12.0" />
                        </font>
                    </Label>

                    <Separator style="-fx-background-color: #404040;" />

                    <!-- Edit Action Buttons -->
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <Button fx:id="btnUpdateMovie" style="-fx-background-color: #ff2525; -fx-text-fill: #FFFFFF; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 32; -fx-background-radius: 5; -fx-cursor: hand;" text="Update Movie">
                            <font>
                                <Font name="SansSerif Bold" size="14.0" />
                            </font>
                        </Button>
                        <Button fx:id="btnDeleteMovie" style="-fx-background-color: #8B0000; -fx-text-fill: #FFFFFF; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 32; -fx-background-radius: 5; -fx-cursor: hand;" text="Delete Movie">
                            <font>
                                <Font name="SansSerif Bold" size="14.0" />
                            </font>
                        </Button>
                    </HBox>
                </VBox>
            </VBox>

        </StackPane>
    </center>

    <!-- Hidden TableView for backward compatibility -->
    <bottom>
        <TableView fx:id="movieTableView" managed="false" visible="false">
            <columns>
                <TableColumn fx:id="colMovieId" text="ID" />
                <TableColumn fx:id="colTitle" text="Title" />
                <TableColumn fx:id="colGenre" text="Genre" />
                <TableColumn fx:id="colDuration" text="Duration" />
                <TableColumn fx:id="colRating" text="Rating" />
                <TableColumn fx:id="colReleaseDate" text="Release Date" />
                <TableColumn fx:id="colStatus" text="Status" />
            </columns>
        </TableView>
    </bottom>
</BorderPane>
