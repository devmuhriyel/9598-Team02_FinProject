<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #292929;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.moviebooking_9598team02_finproject.moviebooking_9598team02_finproject.Client_Java.Admin_Side.CustomerMgmtMVCs.CustomerMgmt.CustomerMgmtView">

    <center>
        <StackPane>

            <!-- ========== LIST PANEL ========== -->
            <StackPane fx:id="listPanel" visible="true">
                <BorderPane>
                    <top>
                        <VBox spacing="15.0" style="-fx-background-color: #292929;">
                            <padding>
                                <Insets bottom="15.0" left="20.0" right="20.0" top="20.0" />
                            </padding>

                            <Label style="-fx-text-fill: #FFFFFF; -fx-font-weight: bold;" text="Customer Management">
                                <font><Font name="SansSerif Bold" size="22.0" /></font>
                            </Label>
                            <Label style="-fx-text-fill: #AAAAAA;" text="View, search, and manage customer accounts.">
                                <font><Font name="SansSerif Regular" size="14.0" /></font>
                            </Label>

                            <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #1A1A1A; -fx-background-radius: 8; -fx-padding: 15;">
                                <TextField fx:id="searchField" prefWidth="400.0" promptText="Search by username, email, name, or Customer ID..." style="-fx-background-color: #404040; -fx-text-fill: #FFFFFF; -fx-prompt-text-fill: #AAAAAA;" HBox.hgrow="ALWAYS" />
                                <Button fx:id="searchButton" prefWidth="100.0" style="-fx-background-color: #7B68EE; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-background-radius: 5;" text="Search" />
                                <Button fx:id="refreshButton" prefWidth="100.0" style="-fx-background-color: #404040; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-background-radius: 5;" text="Refresh" />
                            </HBox>

                            <Text fx:id="listMessageText" style="-fx-fill: #7B68EE;" visible="false" />
                        </VBox>
                    </top>

                    <center>
                        <VBox style="-fx-background-color: #292929;">
                            <padding>
                                <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                            </padding>

                            <VBox spacing="10.0" style="-fx-background-color: #1A1A1A; -fx-background-radius: 8; -fx-padding: 20;" VBox.vgrow="ALWAYS">
                                <Label style="-fx-text-fill: #FFFFFF; -fx-font-weight: bold;" text="Customer Accounts">
                                    <font><Font name="SansSerif Bold" size="16.0" /></font>
                                </Label>

                                <TableView fx:id="customerTable" style="-fx-background-color: #292929; -fx-control-inner-background: #292929;" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colCustomerId" prefWidth="100.0" text="Customer ID" />
                                        <TableColumn fx:id="colUsername" prefWidth="150.0" text="Username" />
                                        <TableColumn fx:id="colEmail" prefWidth="250.0" text="Email" />
                                        <TableColumn fx:id="colFullName" prefWidth="200.0" text="Full Name" />
                                        <TableColumn fx:id="colPhoneNumber" prefWidth="150.0" text="Phone" />
                                    </columns>
                                    <placeholder>
                                        <Label style="-fx-text-fill: #AAAAAA;" text="No customers found." />
                                    </placeholder>
                                </TableView>

                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <Label style="-fx-text-fill: #AAAAAA; -fx-font-size: 12px;" text="Double-click a row to view details" />
                                </HBox>
                            </VBox>
                        </VBox>
                    </center>
                </BorderPane>
            </StackPane>

            <!-- ========== DETAIL PANEL - SIDE BY SIDE ========== -->
            <StackPane fx:id="detailPanel">
                <ScrollPane fitToWidth="true" style="-fx-background: #292929; -fx-background-color: #292929;">
                    <VBox spacing="20" style="-fx-background-color: #292929; -fx-padding: 30;">

                        <!-- Header -->
                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <Button fx:id="backToListButton" style="-fx-background-color: #404040; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-background-radius: 5;" text="← Back to List" />
                            <Label style="-fx-text-fill: #FFFFFF; -fx-font-size: 22; -fx-font-weight: bold;" text="Customer Details" />
                        </HBox>

                        <!-- Message Area -->
                        <Text fx:id="detailMessageText" style="-fx-fill: #7B68EE; -fx-font-size: 14; -fx-font-weight: bold;" visible="false" />

                        <!-- Two Column Layout -->
                        <HBox spacing="20" VBox.vgrow="ALWAYS">

                            <!-- LEFT COLUMN: Basic Information -->
                            <VBox spacing="15" style="-fx-background-color: #1A1A1A; -fx-background-radius: 8; -fx-padding: 25;" HBox.hgrow="ALWAYS">
                                <Label style="-fx-text-fill: #FFFFFF; -fx-font-size: 18; -fx-font-weight: bold;" text="Basic Information" />

                                <Separator style="-fx-background-color: #404040;" />

                                <!-- Customer ID (Read-only) -->
                                <VBox spacing="5">
                                    <Label style="-fx-text-fill: #AAAAAA; -fx-font-size: 12;" text="Customer ID" />
                                    <Label fx:id="detailCustomerIdLabel" style="-fx-text-fill: #FFFFFF; -fx-font-size: 16; -fx-font-weight: bold;" text="1" />
                                </VBox>

                                <!-- Username (Read-only) -->
                                <VBox spacing="5">
                                    <Label style="-fx-text-fill: #AAAAAA; -fx-font-size: 12;" text="Username" />
                                    <Label fx:id="detailUsernameLabel" style="-fx-text-fill: #FFFFFF; -fx-font-size: 16; -fx-font-weight: bold;" text="username" />
                                </VBox>

                                <!-- Email (Editable) -->
                                <VBox spacing="5">
                                    <Label style="-fx-text-fill: #AAAAAA; -fx-font-size: 12;" text="Email Address" />
                                    <TextField fx:id="detailEmailField" promptText="Enter email address" style="-fx-background-color: #404040; -fx-text-fill: #FFFFFF; -fx-prompt-text-fill: #777; -fx-font-size: 14;" />
                                </VBox>

                                <Separator style="-fx-background-color: #404040;" />

                                <!-- Full Name (Editable) -->
                                <VBox spacing="5">
                                    <Label style="-fx-text-fill: #AAAAAA; -fx-font-size: 12;" text="Full Name" />
                                    <TextField fx:id="detailFullNameField" promptText="Enter full name" style="-fx-background-color: #404040; -fx-text-fill: #FFFFFF; -fx-prompt-text-fill: #777; -fx-font-size: 14;" />
                                </VBox>

                                <!-- Phone Number (Editable) -->
                                <VBox spacing="5">
                                    <Label style="-fx-text-fill: #AAAAAA; -fx-font-size: 12;" text="Phone Number" />
                                    <TextField fx:id="detailPhoneField" promptText="Enter phone number" style="-fx-background-color: #404040; -fx-text-fill: #FFFFFF; -fx-prompt-text-fill: #777; -fx-font-size: 14;" />
                                </VBox>

                                <!-- Save Profile Button -->
                                <Button fx:id="saveButton" prefHeight="40" style="-fx-background-color: #7B68EE; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-background-radius: 5; -fx-font-size: 14;" text="💾 Save Customer Info" />
                            </VBox>

                            <!-- RIGHT COLUMN: Actions -->
                            <VBox prefWidth="420" spacing="20" style="-fx-background-color: #1A1A1A; -fx-background-radius: 8; -fx-padding: 25;" HBox.hgrow="NEVER">
                                <Label style="-fx-text-fill: #FFFFFF; -fx-font-size: 18; -fx-font-weight: bold;" text="Account Actions" />

                                <Separator style="-fx-background-color: #404040;" />

                                <!-- Account Status -->
                                <VBox spacing="10" style="-fx-background-color: #252525; -fx-padding: 15; -fx-background-radius: 5;">
                                    <Label style="-fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-font-size: 14;" text="📊 Account Status" />

                                    <HBox alignment="CENTER_LEFT" spacing="10">
                                        <Label style="-fx-text-fill: #AAAAAA; -fx-font-size: 12;" text="Status:" />
                                        <Label fx:id="statusLabel" style="-fx-text-fill: #4CAF50; -fx-font-weight: bold; -fx-font-size: 14;" text="Active" />
                                    </HBox>

                                    <VBox spacing="5">
                                        <Label style="-fx-text-fill: #AAAAAA; -fx-font-size: 12;" text="Account Created" />
                                        <Label fx:id="createdAtLabel" style="-fx-text-fill: #FFFFFF; -fx-font-size: 12;" text="2024-01-01" />
                                    </VBox>
                                </VBox>

                                <Separator style="-fx-background-color: #404040;" />

                            </VBox>

                        </HBox>

                    </VBox>
                </ScrollPane>
            </StackPane>

        </StackPane>
    </center>
</BorderPane>
