<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #292929;"
            xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.moviebooking_9598team02_finproject.moviebooking_9598team02_finproject.Client_Java.Admin_Side.CustomerMgmtMVCs.CustomerMgmt.CustomerMgmtView">

    <center>
        <StackPane>

            <!-- ========== LIST PANEL ========== -->
            <StackPane fx:id="listPanel" visible="true">
                <BorderPane>
                    <top>
                        <VBox spacing="15.0" style="-fx-background-color: #292929;">
                            <padding>
                                <Insets top="20.0" right="20.0" bottom="15.0" left="20.0"/>
                            </padding>

                            <Label style="-fx-text-fill: #FFFFFF; -fx-font-weight: bold;" text="Customer Management">
                                <font><Font name="SansSerif Bold" size="22.0" /></font>
                            </Label>
                            <Label style="-fx-text-fill: #AAAAAA;" text="View, search, and manage customer accounts.">
                                <font><Font name="SansSerif Regular" size="14.0" /></font>
                            </Label>

                            <HBox spacing="10.0" alignment="CENTER_LEFT" style="-fx-background-color: #1A1A1A; -fx-background-radius: 8; -fx-padding: 15;">
                                <TextField fx:id="searchField" promptText="Search by username, email, name, or Customer ID..."
                                           HBox.hgrow="ALWAYS" prefWidth="400.0"
                                           style="-fx-background-color: #404040; -fx-text-fill: #FFFFFF; -fx-prompt-text-fill: #AAAAAA;"/>
                                <Button fx:id="searchButton" text="Search"
                                        style="-fx-background-color: #ff2525; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-background-radius: 5;"
                                        prefWidth="100.0"/>
                                <Button fx:id="refreshButton" text="Refresh"
                                        style="-fx-background-color: #404040; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-background-radius: 5;"
                                        prefWidth="100.0"/>
                            </HBox>

                            <Text fx:id="listMessageText" visible="false" style="-fx-fill: #ff2525;"/>
                        </VBox>
                    </top>

                    <center>
                        <VBox style="-fx-background-color: #292929;">
                            <padding>
                                <Insets top="10.0" right="20.0" bottom="10.0" left="20.0"/>
                            </padding>

                            <VBox spacing="10.0" style="-fx-background-color: #1A1A1A; -fx-background-radius: 8; -fx-padding: 20;" VBox.vgrow="ALWAYS">
                                <Label text="Customer Accounts" style="-fx-text-fill: #FFFFFF; -fx-font-weight: bold;">
                                    <font><Font name="SansSerif Bold" size="16.0" /></font>
                                </Label>

                                <TableView fx:id="customerTable" VBox.vgrow="ALWAYS"
                                           style="-fx-background-color: #292929; -fx-control-inner-background: #292929;">
                                    <columns>
                                        <TableColumn fx:id="colCustomerId" text="Customer ID" prefWidth="100.0"/>
                                        <TableColumn fx:id="colUsername" text="Username" prefWidth="150.0"/>
                                        <TableColumn fx:id="colEmail" text="Email" prefWidth="250.0"/>
                                        <TableColumn fx:id="colFullName" text="Full Name" prefWidth="200.0"/>
                                        <TableColumn fx:id="colPhoneNumber" text="Phone" prefWidth="150.0"/>
                                    </columns>
                                    <placeholder>
                                        <Label style="-fx-text-fill: #AAAAAA;" text="No customers found."/>
                                    </placeholder>
                                </TableView>

                                <HBox spacing="10.0" alignment="CENTER_LEFT">
                                    <Label text="Double-click a row to view details" style="-fx-text-fill: #AAAAAA; -fx-font-size: 12px;"/>
                                </HBox>
                            </VBox>
                        </VBox>
                    </center>
                </BorderPane>
            </StackPane>

            <!-- ========== DETAIL PANEL ========== -->
            <StackPane fx:id="detailPanel" visible="false">
                <ScrollPane fitToWidth="true" style="-fx-background: #292929; -fx-background-color: #292929;">
                    <VBox spacing="20" style="-fx-background-color: #292929; -fx-padding: 30;">

                        <!-- Header -->
                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <Button fx:id="backToListButton" text="← Back to List"
                                    style="-fx-background-color: #404040; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-background-radius: 5;"/>
                            <Label text="Customer Details" style="-fx-text-fill: #FFFFFF; -fx-font-size: 22; -fx-font-weight: bold;"/>
                        </HBox>

                        <!-- Message Area -->
                        <Text fx:id="detailMessageText" visible="false" style="-fx-fill: #4CAF50; -fx-font-size: 14; -fx-font-weight: bold;"/>

                        <!-- Customer Information Card -->
                        <VBox spacing="15" style="-fx-background-color: #1A1A1A; -fx-background-radius: 8; -fx-padding: 25;" HBox.hgrow="ALWAYS">
                            <Label text="Customer Information" style="-fx-text-fill: #FFFFFF; -fx-font-size: 18; -fx-font-weight: bold;"/>

                            <Separator style="-fx-background-color: #404040;"/>

                            <GridPane hgap="20" vgap="15">
                                <!-- Customer ID (Read-only) -->
                                <Label text="Customer ID:" GridPane.columnIndex="0" GridPane.rowIndex="0"
                                       style="-fx-text-fill: #AAAAAA; -fx-font-size: 12;"/>
                                <Label fx:id="detailCustomerIdLabel" text="1" GridPane.columnIndex="1" GridPane.rowIndex="0"
                                       style="-fx-text-fill: #FFFFFF; -fx-font-size: 16; -fx-font-weight: bold;"/>

                                <!-- Username (Read-only) -->
                                <Label text="Username:" GridPane.columnIndex="0" GridPane.rowIndex="1"
                                       style="-fx-text-fill: #AAAAAA; -fx-font-size: 12;"/>
                                <Label fx:id="detailUsernameLabel" text="username" GridPane.columnIndex="1" GridPane.rowIndex="1"
                                       style="-fx-text-fill: #FFFFFF; -fx-font-size: 16; -fx-font-weight: bold;"/>

                                <!-- Status -->
                                <Label text="Status:" GridPane.columnIndex="0" GridPane.rowIndex="2"
                                       style="-fx-text-fill: #AAAAAA; -fx-font-size: 12;"/>
                                <Label fx:id="statusLabel" text="Active" GridPane.columnIndex="1" GridPane.rowIndex="2"
                                       style="-fx-text-fill: #4CAF50; -fx-font-weight: bold; -fx-font-size: 14;"/>

                                <!-- Created At -->
                                <Label text="Member Since:" GridPane.columnIndex="0" GridPane.rowIndex="3"
                                       style="-fx-text-fill: #AAAAAA; -fx-font-size: 12;"/>
                                <Label fx:id="createdAtLabel" text="N/A" GridPane.columnIndex="1" GridPane.rowIndex="3"
                                       style="-fx-text-fill: #FFFFFF; -fx-font-size: 14;"/>
                            </GridPane>

                            <Separator style="-fx-background-color: #404040;"/>

                            <Label text="Editable Information" style="-fx-text-fill: #FFFFFF; -fx-font-size: 16; -fx-font-weight: bold;"/>

                            <!-- Email (Editable) -->
                            <VBox spacing="5">
                                <Label text="Email Address" style="-fx-text-fill: #AAAAAA; -fx-font-size: 12;"/>
                                <TextField fx:id="detailEmailField" promptText="Enter email address"
                                           style="-fx-background-color: #404040; -fx-text-fill: #FFFFFF; -fx-prompt-text-fill: #777; -fx-font-size: 14;"/>
                            </VBox>

                            <!-- Full Name (Editable) -->
                            <VBox spacing="5">
                                <Label text="Full Name" style="-fx-text-fill: #AAAAAA; -fx-font-size: 12;"/>
                                <TextField fx:id="detailFullNameField" promptText="Enter full name"
                                           style="-fx-background-color: #404040; -fx-text-fill: #FFFFFF; -fx-prompt-text-fill: #777; -fx-font-size: 14;"/>
                            </VBox>

                            <!-- Phone Number (Editable) -->
                            <VBox spacing="5">
                                <Label text="Phone Number" style="-fx-text-fill: #AAAAAA; -fx-font-size: 12;"/>
                                <TextField fx:id="detailPhoneField" promptText="Enter phone number"
                                           style="-fx-background-color: #404040; -fx-text-fill: #FFFFFF; -fx-prompt-text-fill: #777; -fx-font-size: 14;"/>
                            </VBox>

                            <!-- Save Button -->
                            <Button fx:id="saveButton" text="💾 Save Customer Info" prefHeight="40"
                                    style="-fx-background-color: #4CAF50; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-background-radius: 5; -fx-font-size: 14;"/>
                        </VBox>

                    </VBox>
                </ScrollPane>
            </StackPane>

        </StackPane>
    </center>
</BorderPane>