<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.moviebooking_9598team02_finproject.moviebooking_9598team02_finproject.Client_Java.Customer_Side.MovieMVCs.CustomerMovieView">

    <!-- MOVIE LIST VIEW -->
    <VBox fx:id="movieListView" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="700.0" prefWidth="1060.0" style="-fx-background-color: #1A1A1A;">

        <padding>
            <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
        </padding>

        <children>
            <!-- Header -->
            <Label style="-fx-font-weight: bold; -fx-font-size: 28px;" text="🎬 Browse Movies" textFill="WHITE">
                <VBox.margin>
                    <Insets bottom="20.0" />
                </VBox.margin>
            </Label>

            <!-- Search Bar -->
            <HBox alignment="CENTER_LEFT" spacing="20.0">
                <children>
                    <TextField fx:id="searchField" prefHeight="40.0" prefWidth="300.0" promptText="Search movie title..." style="-fx-background-color: #2D2D2D; -fx-text-fill: white; -fx-prompt-text-fill: #999999; -fx-background-radius: 5;" />
                </children>
                <VBox.margin>
                    <Insets bottom="20.0" />
                </VBox.margin>
            </HBox>

            <!-- Status Message Label -->
            <Label fx:id="statusMessageLabel" style="-fx-font-weight: bold;" text="" textFill="#00CC66" visible="false">
                <VBox.margin>
                    <Insets bottom="10.0" />
                </VBox.margin>
            </Label>

            <!-- Movie Cards Container -->
            <ScrollPane fx:id="movieScrollPane" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: #1A1A1A; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                <content>
                    <TilePane fx:id="movieTilePane" hgap="25.0" prefWidth="1000.0" style="-fx-background-color: #1A1A1A;" vgap="25.0">
                    </TilePane>
                </content>
            </ScrollPane>
        </children>
    </VBox>

    <!-- MOVIE DETAILS VIEW -->
    <VBox fx:id="movieDetailsView" managed="false" spacing="20.0" style="-fx-background-color: #1A1A1A;" visible="false">
        <padding>
            <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
        </padding>

        <!-- Back Button -->
        <HBox alignment="CENTER_LEFT">
            <Button fx:id="btnBackToList" style="-fx-background-color: transparent; -fx-text-fill: #00CC66; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand; -fx-underline: true;" text="← Back to Movies">
                <font>
                    <Font name="SansSerif Bold" size="14.0" />
                </font>
            </Button>
        </HBox>

        <!-- Movie Details Container -->
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: #1A1A1A; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
            <VBox spacing="20.0" style="-fx-background-color: #292929; -fx-padding: 30; -fx-background-radius: 8;">

                <!-- Movie Header with Poster -->
                <HBox spacing="30.0">
                    <!-- Movie Poster -->
                    <VBox alignment="TOP_CENTER" spacing="10.0">
                        <ImageView fx:id="moviePosterImageView" fitHeight="400.0" fitWidth="300.0" preserveRatio="true" smooth="true" style="-fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.8), 10, 0, 0, 0);">
                        </ImageView>
                    </VBox>

                    <!-- Movie Info -->
                    <VBox spacing="15.0" HBox.hgrow="ALWAYS">
                        <Label fx:id="movieTitleLabel" style="-fx-text-fill: #FFFFFF; -fx-font-size: 32px; -fx-font-weight: bold;" text="Movie Title" wrapText="true">
                            <font>
                                <Font name="SansSerif Bold" size="32.0" />
                            </font>
                        </Label>

                        <Label fx:id="movieGenreLabel" style="-fx-text-fill: #00CC66; -fx-font-size: 16px;" text="Genres: Action, Adventure">
                            <font>
                                <Font name="SansSerif Regular" size="16.0" />
                            </font>
                        </Label>

                        <Label fx:id="movieRatingLabel" style="-fx-text-fill: #FFD700; -fx-font-size: 18px; -fx-font-weight: bold;" text="⭐ 9/10">
                            <font>
                                <Font name="SansSerif Bold" size="18.0" />
                            </font>
                        </Label>

                        <Separator style="-fx-background-color: #404040;" />

                        <Label style="-fx-text-fill: #CCCCCC; -fx-font-size: 14px; -fx-font-weight: bold;" text="Description">
                            <font>
                                <Font name="SansSerif Bold" size="14.0" />
                            </font>
                        </Label>

                        <TextArea fx:id="movieDescriptionArea" editable="false" prefRowCount="6" style="-fx-control-inner-background: #1A1A1A; -fx-text-fill: #FFFFFF; -fx-border-color: #404040; -fx-border-width: 1; -fx-border-radius: 5; -fx-font-size: 13px;" wrapText="true">
                            <font>
                                <Font name="SansSerif Regular" size="13.0" />
                            </font>
                        </TextArea>
                    </VBox>
                </HBox>

                <Separator style="-fx-background-color: #404040;" />

                <!-- Available Schedules Section -->
                <VBox spacing="15.0">
                    <Label style="-fx-text-fill: #FFFFFF; -fx-font-size: 20px; -fx-font-weight: bold;" text="Available Schedules">
                        <font>
                            <Font name="SansSerif Bold" size="20.0" />
                        </font>
                    </Label>

                    <!-- Schedule Cards Grid -->
                    <VBox spacing="20.0">
                        <GridPane fx:id="scheduleGridPane" hgap="20.0" vgap="20.0" />

                        <!-- Pagination -->
                        <HBox alignment="CENTER" spacing="15.0" style="-fx-padding: 10 0 0 0;">
                            <Button fx:id="btnPreviousSchedulePage" style="-fx-background-color: #1A1A1A; -fx-border-color: #00CC66; -fx-border-width: 2; -fx-border-radius: 5; -fx-padding: 8 15; -fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #00CC66; -fx-cursor: hand;" text="&lt;">
                                <font>
                                    <Font name="SansSerif Bold" size="16.0" />
                                </font>
                            </Button>
                            <Label fx:id="schedulePageLabel" style="-fx-text-fill: #FFFFFF; -fx-font-size: 18px; -fx-font-weight: bold;" text="1">
                                <font>
                                    <Font name="SansSerif Bold" size="18.0" />
                                </font>
                            </Label>
                            <Button fx:id="btnNextSchedulePage" style="-fx-background-color: #1A1A1A; -fx-border-color: #00CC66; -fx-border-width: 2; -fx-border-radius: 5; -fx-padding: 8 15; -fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #00CC66; -fx-cursor: hand;" text="&gt;">
                                <font>
                                    <Font name="SansSerif Bold" size="16.0" />
                                </font>
                            </Button>
                        </HBox>
                    </VBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </VBox>

</StackPane>
