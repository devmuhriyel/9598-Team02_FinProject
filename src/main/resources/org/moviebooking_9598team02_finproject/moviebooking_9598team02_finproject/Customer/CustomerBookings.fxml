<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="700.0" prefWidth="1060.0" spacing="20.0" style="-fx-background-color: #1A1A1A;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>
    <children>
        <Label style="-fx-font-weight: bold; -fx-font-size: 28px;" text="🎟️ My Bookings" textFill="WHITE">
            <VBox.margin>
                <Insets bottom="10.0" />
            </VBox.margin>
        </Label>
        <Label text="View and manage your upcoming movie tickets." textFill="#cccccc">
            <VBox.margin>
                <Insets bottom="10.0" />
            </VBox.margin>
        </Label>

        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: #1A1A1A; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
            <content>
                <VBox fx:id="bookingsContainer" spacing="15.0" style="-fx-background-color: #1A1A1A;">

                    <VBox prefWidth="1000.0" style="-fx-background-color: #2D2D2D; -fx-padding: 20; -fx-background-radius: 8;">
                        <children>
                            <HBox alignment="CENTER_LEFT" spacing="20.0">
                                <children>
                                    <VBox prefHeight="60.0" prefWidth="60.0" style="-fx-background-color: #444444; -fx-background-radius: 4;" />
                                    <VBox>
                                        <children>
                                            <Label style="-fx-font-weight: bold; -fx-font-size: 20px;" text="Avatar: The Way of Water" textFill="#FF6B6B" />
                                            <Label text="Upcoming Showing" textFill="#888888" />
                                        </children>
                                    </VBox>
                                    <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                                        <children>
                                            <Button mnemonicParsing="false" prefHeight="40.0" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" text="View E-Ticket" />
                                        </children>
                                    </HBox>
                                </children>
                                <VBox.margin>
                                    <Insets bottom="10.0" />
                                </VBox.margin>
                            </HBox>
                            <HBox spacing="40.0">
                                <children>
                                    <VBox spacing="5.0">
                                        <children>
                                            <Label text="Cinema/Hall:" textFill="#cccccc" />
                                            <Label text="SM City Cinema 3" textFill="WHITE">
                                                <font>
                                                    <Font name="System Bold" size="14.0" />
                                                </font>
                                            </Label>
                                        </children>
                                    </VBox>
                                    <VBox spacing="5.0">
                                        <children>
                                            <Label text="Date &amp; Time:" textFill="#cccccc" />
                                            <Label text="Dec 20, 2025 @ 7:00 PM" textFill="WHITE">
                                                <font>
                                                    <Font name="System Bold" size="14.0" />
                                                </font>
                                            </Label>
                                        </children>
                                    </VBox>
                                    <VBox spacing="5.0">
                                        <children>
                                            <Label text="Seats:" textFill="#cccccc" />
                                            <Label text="G10, G11" textFill="WHITE">
                                                <font>
                                                    <Font name="System Bold" size="14.0" />
                                                </font>
                                            </Label>
                                        </children>
                                    </VBox>
                                    <VBox spacing="5.0">
                                        <children>
                                            <Label text="Total Paid:" textFill="#cccccc" />
                                            <Label text="P 850.00" textFill="#FFD700">
                                                <font>
                                                    <Font name="System Bold" size="14.0" />
                                                </font>
                                            </Label>
                                        </children>
                                    </VBox>
                                </children>
                            </HBox>
                        </children>
                    </VBox>

                </VBox>
            </content>
            <VBox.margin>
                <Insets />
            </VBox.margin>
        </ScrollPane>
    </children>
</VBox>