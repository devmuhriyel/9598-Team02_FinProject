<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>

<VBox fx:id="rootVBox" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="700.0" prefWidth="1060.0" spacing="20.0" style="-fx-background-color: #1A1A1A;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>
    <children>
        <Label style="-fx-font-weight: bold; -fx-font-size: 28px;" text="🎟️ My Bookings" textFill="WHITE">
            <VBox.margin>
                <Insets bottom="10.0" />
            </VBox.margin>
        </Label>
        <Label text="View and manage your past and upcoming movie tickets." textFill="#cccccc">
            <VBox.margin>
                <Insets bottom="10.0" />
            </VBox.margin>
        </Label>

        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <Label text="Filter:" textFill="WHITE" style="-fx-font-weight: bold;" />

                <ComboBox fx:id="comboFilterWatched" prefWidth="150.0" promptText="Time Period" style="-fx-background-color: #FFFFFF; -fx-text-fill: white;" />

                <ComboBox fx:id="comboFilterStatus" prefWidth="150.0" promptText="Status" style="-fx-background-color: #FFFFFF; -fx-text-fill: white;" />

                <Button fx:id="btnRefresh" text="Refresh" style="-fx-background-color: #FF6B6B; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" />

                <Label fx:id="lblStatusMessage" text="" HBox.hgrow="ALWAYS" textFill="YELLOW"/>
            </children>
            <VBox.margin>
                <Insets bottom="10.0" />
            </VBox.margin>
        </HBox>

        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: #1A1A1A; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
            <content>
                <VBox fx:id="vbBookingsList" spacing="15.0" style="-fx-background-color: #1A1A1A;">
                    <children>
                        <Label fx:id="lblNoBookings" text="Loading booking history..." textFill="#cccccc" style="-fx-font-style: italic;" />
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</VBox>