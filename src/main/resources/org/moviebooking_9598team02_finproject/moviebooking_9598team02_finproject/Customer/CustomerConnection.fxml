<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.moviebooking_9598team02_finproject.moviebooking_9598team02_finproject.Client_Java.Customer_Side.CustomerParentView">
    <left>
        <AnchorPane prefHeight="400.0" prefWidth="240.0" BorderPane.alignment="CENTER">
            <children>
                <Pane id="leftFrame" prefHeight="400.0" prefWidth="240.0" style="-fx-background-color: #202020;" stylesheets="@../style.css">
                    <children>
                        <!-- Logo/Branding Section -->
                        <Text fill="#FF2525" layoutX="40.0" layoutY="80.0" strokeType="OUTSIDE" strokeWidth="0.0" text="FILMBOOK" textAlignment="CENTER">
                            <font>
                                <Font name="SansSerif Bold" size="28.0" />
                            </font>
                        </Text>

                        <Text fill="WHITE" layoutX="50.0" layoutY="110.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Customer Portal" textAlignment="CENTER">
                            <font>
                                <Font name="SansSerif Regular" size="14.0" />
                            </font>
                        </Text>

                        <!-- Input Section -->
                        <AnchorPane id="inputFrame" layoutX="15.0" layoutY="150.0" prefHeight="240.0" prefWidth="210.0" stylesheets="@../style.css">
                            <children>
                                <Label layoutX="20.0" layoutY="10.0" text="IP Address:" textFill="WHITE">
                                    <font>
                                        <Font name="SansSerif Bold" size="12.0" />
                                    </font>
                                </Label>

                                <TextField id="ipAddressInput" fx:id="ipField" layoutX="20.0" layoutY="32.0" prefHeight="35.0" prefWidth="170.0" promptText="localhost" stylesheets="@../style.css">
                                    <font>
                                        <Font name="SansSerif Regular" size="12.0" />
                                    </font>
                                </TextField>

                                <Label layoutX="20.0" layoutY="80.0" text="Port:" textFill="WHITE">
                                    <font>
                                        <Font name="SansSerif Bold" size="12.0" />
                                    </font>
                                </Label>

                                <TextField id="portInput" fx:id="portField" layoutX="20.0" layoutY="102.0" prefHeight="35.0" prefWidth="170.0" promptText="1050" stylesheets="@../style.css">
                                    <font>
                                        <Font name="SansSerif Regular" size="12.0" />
                                    </font>
                                </TextField>

                                <Button id="button-style" fx:id="connectButton" layoutX="88.0" layoutY="160.0" mnemonicParsing="false" prefHeight="35.0" prefWidth="35.0" stylesheets="@../style.css" text="&gt;">
                                    <font>
                                        <Font name="SansSerif Bold" size="14.0" />
                                    </font>
                                </Button>

                                <Text fx:id="errorText" fill="#FF2525" layoutX="20.0" layoutY="215.0" strokeType="OUTSIDE" strokeWidth="0.0" text="..." textAlignment="CENTER" visible="true" wrappingWidth="170.0">
                                    <font>
                                        <Font name="SansSerif Regular" size="11.0" />
                                    </font>
                                </Text>
                            </children>
                        </AnchorPane>
                    </children>
                </Pane>
            </children>
        </AnchorPane>
    </left>
    <right>
        <AnchorPane prefHeight="400.0" prefWidth="360.0" BorderPane.alignment="CENTER">
            <children>
                <ImageView id="backgroundImage" fitHeight="400.0" fitWidth="360.0" pickOnBounds="true" preserveRatio="false">
                    <image>
                        <Image url="@/Images/connectionImage.jpg" />
                    </image>
                </ImageView>
            </children>
        </AnchorPane>
    </right>
</BorderPane>
