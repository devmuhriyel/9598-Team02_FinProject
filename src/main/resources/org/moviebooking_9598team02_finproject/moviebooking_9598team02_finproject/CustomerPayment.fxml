<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="450.0" style="-fx-background-color: #292929; -fx-border-color: #ff2525; -fx-border-width: 2;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.moviebooking_9598team02_finproject.moviebooking_9598team02_finproject.Client_Java.Customer_Side.PaymentMVCs.PaymentView">

    <top>
        <VBox alignment="CENTER" style="-fx-background-color: #1A1A1A; -fx-border-color: #444444; -fx-border-width: 0 0 1 0; -fx-padding: 15;">
            <Label text="FILMBOOK CINEMAS" textFill="#ff2525">
                <font><Font name="SansSerif Bold" size="22.0" /></font>
            </Label>
            <Label text="Payment Receipt" textFill="#FFFFFF">
                <font><Font name="SansSerif Regular" size="12.0" /></font>
            </Label>
        </VBox>
    </top>

    <center>
        <VBox alignment="TOP_CENTER" spacing="0.0" style="-fx-background-color: #FFFFFF; -fx-padding: 25 30 25 30;">

            <!-- Receipt Header -->
            <VBox alignment="CENTER" spacing="5.0" style="-fx-padding: 0 0 15 0;">
                <Label text="BOOKING CONFIRMATION" style="-fx-font-weight: bold; -fx-font-size: 14;">
                    <font><Font name="SansSerif Bold" size="14.0" /></font>
                </Label>
                <Label fx:id="lblReceiptDate" text="Date: December 08, 2025" style="-fx-font-size: 11;" />
                <Label fx:id="lblReceiptTime" text="Time: 02:30 PM" style="-fx-font-size: 11;" />
            </VBox>

            <Separator style="-fx-border-style: dashed; -fx-border-width: 1 0 0 0; -fx-border-color: #333333;" />

            <!-- Booking Details -->
            <VBox spacing="8.0" style="-fx-padding: 15 0 15 0;">
                <Label text="BOOKING DETAILS" style="-fx-font-weight: bold; -fx-font-size: 12; -fx-underline: true;" />

                <HBox>
                    <Label text="Booking ID:" prefWidth="120.0" style="-fx-font-size: 11;" />
                    <Label fx:id="lblBookingId" text="BK-00001" style="-fx-font-weight: bold; -fx-font-size: 11;" />
                </HBox>

                <HBox>
                    <Label text="Customer:" prefWidth="120.0" style="-fx-font-size: 11;" />
                    <Label fx:id="lblCustomerName" text="John Doe" style="-fx-font-size: 11;" />
                </HBox>
            </VBox>

            <Separator style="-fx-border-style: dashed; -fx-border-width: 1 0 0 0; -fx-border-color: #333333;" />

            <!-- Movie Information -->
            <VBox spacing="8.0" style="-fx-padding: 15 0 15 0;">
                <Label text="MOVIE INFORMATION" style="-fx-font-weight: bold; -fx-font-size: 12; -fx-underline: true;" />

                <HBox>
                    <Label text="Movie:" prefWidth="120.0" style="-fx-font-size: 11;" />
                    <Label fx:id="lblMovieTitle" text="Avengers: Endgame" style="-fx-font-weight: bold; -fx-font-size: 11;" />
                </HBox>

                <HBox>
                    <Label text="Show Date:" prefWidth="120.0" style="-fx-font-size: 11;" />
                    <Label fx:id="lblShowDate" text="Dec 10, 2025" style="-fx-font-size: 11;" />
                </HBox>

                <HBox>
                    <Label text="Show Time:" prefWidth="120.0" style="-fx-font-size: 11;" />
                    <Label fx:id="lblShowTime" text="7:30 PM" style="-fx-font-size: 11;" />
                </HBox>

                <HBox>
                    <Label text="Cinema:" prefWidth="120.0" style="-fx-font-size: 11;" />
                    <Label fx:id="lblCinema" text="Cinema 1" style="-fx-font-size: 11;" />
                </HBox>

                <HBox>
                    <Label text="Seats:" prefWidth="120.0" style="-fx-font-size: 11;" />
                    <Label fx:id="lblSeats" text="A5, A6, A7" style="-fx-font-weight: bold; -fx-font-size: 11;" />
                </HBox>
            </VBox>

            <Separator style="-fx-border-style: dashed; -fx-border-width: 1 0 0 0; -fx-border-color: #333333;" />

            <!-- Price Breakdown -->
            <VBox spacing="8.0" style="-fx-padding: 15 0 15 0;">
                <Label text="PRICE BREAKDOWN" style="-fx-font-weight: bold; -fx-font-size: 12; -fx-underline: true;" />

                <HBox>
                    <Label text="Ticket Price:" prefWidth="120.0" style="-fx-font-size: 11;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblTicketPrice" text="₱ 0.00" style="-fx-font-size: 11;" />
                </HBox>

                <HBox>
                    <Label text="No. of Tickets:" prefWidth="120.0" style="-fx-font-size: 11;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblTicketCount" text="x 0" style="-fx-font-size: 11;" />
                </HBox>

                <HBox>
                    <Label text="Subtotal:" prefWidth="120.0" style="-fx-font-size: 11;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblSubtotal" text="₱ 0.00" style="-fx-font-size: 11;" />
                </HBox>

                <HBox>
                    <Label text="Other Fee:" prefWidth="120.0" style="-fx-font-size: 11;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblServiceFee" text="₱ 0.00" style="-fx-font-size: 11;" />
                </HBox>
            </VBox>

            <Separator style="-fx-border-style: solid; -fx-border-width: 2 0 0 0; -fx-border-color: #333333;" />

            <!-- Total Amount -->
            <HBox alignment="CENTER_LEFT" style="-fx-padding: 15 0 15 0;">
                <Label text="TOTAL AMOUNT:" style="-fx-font-weight: bold; -fx-font-size: 14;" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="lblAmount" text="₱ 0.00" style="-fx-font-weight: bold; -fx-font-size: 16; -fx-text-fill: #ff2525;" />
            </HBox>

            <Separator style="-fx-border-style: dashed; -fx-border-width: 1 0 0 0; -fx-border-color: #333333;" />

            <!-- Payment Method Selection -->
            <VBox spacing="8.0" style="-fx-padding: 15 0 10 0;">
                <Label text="SELECT PAYMENT METHOD" style="-fx-font-weight: bold; -fx-font-size: 11; -fx-underline: true;" />
                <ComboBox fx:id="comboPaymentMethod" prefWidth="390.0" promptText="Choose payment method..." style="-fx-font-size: 12;" />
            </VBox>

            <!-- Transaction ID -->
            <VBox spacing="8.0" style="-fx-padding: 10 0 15 0;">
                <Label text="TRANSACTION REFERENCE" style="-fx-font-weight: bold; -fx-font-size: 11; -fx-underline: true;" />
                <TextField fx:id="txtTransactionId" promptText="Enter reference number..." style="-fx-font-size: 12; -fx-padding: 8;" />
                <Label text="* Auto-generated for Cash payment" style="-fx-font-size: 9; -fx-text-fill: #666666; -fx-font-style: italic;" />
            </VBox>

            <Separator style="-fx-border-style: dashed; -fx-border-width: 1 0 0 0; -fx-border-color: #333333;" />

            <!-- Status Message -->
            <Label fx:id="lblStatus" alignment="CENTER" maxWidth="390.0" text="" textAlignment="CENTER" visible="false" wrapText="true" style="-fx-font-weight: bold; -fx-padding: 10; -fx-background-radius: 3; -fx-font-size: 11;">
                <VBox.margin>
                    <Insets top="10" />
                </VBox.margin>
            </Label>

            <!-- Footer Note -->
            <VBox alignment="CENTER" spacing="5.0" style="-fx-padding: 15 0 0 0;">
                <Label text="━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" style="-fx-font-size: 10; -fx-text-fill: #CCCCCC;" />
                <Label text="Thank you for choosing FILMBOOK!" style="-fx-font-weight: bold; -fx-font-size: 11;" />
                <Label text="Keep this receipt for your records" style="-fx-font-size: 9; -fx-text-fill: #666666;" />
            </VBox>

        </VBox>
    </center>

    <bottom>
        <VBox spacing="10.0" alignment="CENTER" style="-fx-background-color: #1A1A1A; -fx-padding: 20;">
            <Button fx:id="btnConfirmPayment" prefHeight="40.0" prefWidth="390.0"
                    style="-fx-background-color: #ff2525; -fx-text-fill: white;"
                    text="CONFIRM &amp; PAY NOW">
                <font><Font name="SansSerif Bold" size="14.0" /></font>
            </Button>

            <Button fx:id="btnCancel" text="Cancel Transaction" textFill="#888888"
                    style="-fx-background-color: transparent; -fx-underline: true;">
                <font><Font name="SansSerif Regular" size="11.0" /></font>
            </Button>
        </VBox>
    </bottom>

</BorderPane>