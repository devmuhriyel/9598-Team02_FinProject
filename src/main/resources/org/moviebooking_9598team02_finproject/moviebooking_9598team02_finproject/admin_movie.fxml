<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<!--
    JavaFX FXML Implementation of the Admin Dashboard Layout,
    currently displaying the Movie Management feature with an ADD/EDIT Movie Form.
-->

<BorderPane prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #1A1A1A;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.moviebooking_9598team02_finproject.moviebooking_9598team02_finproject.Admin.AdminBase"> <!-- SecondaryBackground -->

    <!-- 1. Top Header Component -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="60.0" spacing="20.0" style="-fx-background-color: #000000; -fx-padding: 0 20 0 20;"> <!-- PrimaryBackground -->
            <Label style="-fx-text-fill: #FFC72C;" text="FILMBOOK | Admin"> <!-- Active Color -->
                <font><Font size="24.0" /></font>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
            <Label style="-fx-text-fill: #FFFFFF;" text="Admin Name | Logout"> <!-- TextPrimary -->
                <font><Font size="14.0" /></font>
            </Label>
        </HBox>
    </top>

    <!-- 2. Main Body -->
    <left>
        <!-- 2.1. Navigation Sidebar (VBox) -->
        <VBox prefWidth="220.0" spacing="10.0" style="-fx-background-color: #000000; -fx-border-color: #AAAAAA; -fx-border-width: 0 1 0 0;"> <!-- PrimaryBackground & TextSecondary border -->
            <padding>
                <Insets bottom="20.0" left="10.0" right="10.0" top="20.0" />
            </padding>

            <!-- MenuItem: Dashboard (Inactive) -->
            <Label prefWidth="1.7976931348623157E308" style="-fx-text-fill: #FFFFFF; -fx-padding: 8 10; -fx-cursor: hand;" text="DASHBOARD" />

            <!-- MenuItem: Movie Management (Active) -->
            <Label prefWidth="1.7976931348623157E308" style="-fx-text-fill: #FFC72C; -fx-background-color: #1A1A1A; -fx-padding: 8 10; -fx-font-weight: bold; -fx-border-radius: 5; -fx-background-radius: 5;" text="MOVIE MANAGEMENT"> <!-- Active Color & SecondaryBackground hover effect -->
            </Label>

            <!-- Other Menu Items (Inactive) -->
            <Label prefWidth="1.7976931348623157E308" style="-fx-text-fill: #FFFFFF; -fx-padding: 8 10; -fx-cursor: hand;" text="SHOWTIME SCHEDULING" />
            <Label prefWidth="1.7976931348623157E308" style="-fx-text-fill: #FFFFFF; -fx-padding: 8 10; -fx-cursor: hand;" text="BOOKING MANAGEMENT" />
            <Label prefWidth="1.7976931348623157E308" style="-fx-text-fill: #FFFFFF; -fx-padding: 8 10; -fx-cursor: hand;" text="CUSTOMER MANAGEMENT" />
            <Label prefWidth="1.7976931348623157E308" style="-fx-text-fill: #FFFFFF; -fx-padding: 8 10; -fx-cursor: hand;" text="REPORTS &amp; ANALYTICS" />
        </VBox>
    </left>

    <!-- 2.2. Main Content Area (Center) - Now showing Add/Edit Movie Form -->
    <center>
        <!-- ScrollPane is added to ensure the form is usable on smaller screens -->
        <ScrollPane fitToWidth="true" style="-fx-background-color: #1A1A1A; -fx-border-insets: 0; -fx-padding: 0;">
            <content>
                <VBox spacing="20.0" style="-fx-background-color: #1A1A1A;"> <!-- SecondaryBackground -->
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>

                    <!-- Header -->
                    <Label style="-fx-text-fill: #FFFFFF; -fx-font-weight: bold;" text="Add/Edit Movie Details">
                        <font><Font size="22.0" /></font>
                    </Label>
                    <Label style="-fx-text-fill: #AAAAAA;" text="Enter or modify the information for the new cinema release.">
                        <font><Font size="14.0" /></font>
                    </Label>

                    <!-- Movie Form Container (GridPane for structure) -->
                    <GridPane hgap="20.0" style="-fx-padding: 20; -fx-background-color: #2e2e2e; -fx-background-radius: 8;" vgap="15.0">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="20" /> <!-- Labels -->
                            <ColumnConstraints percentWidth="80" /> <!-- Fields -->
                        </columnConstraints>

                        <!-- Row 1: Title -->
                        <Label style="-fx-text-fill: #FFFFFF;" text="Movie Title:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <TextField promptText="e.g., The Midnight Rider" style="-fx-background-color: #404040; -fx-text-fill: #FFFFFF; -fx-prompt-text-fill: #AAAAAA;" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                        <!-- Row 2: Genre -->
                        <Label style="-fx-text-fill: #FFFFFF;" text="Genre:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <ComboBox prefWidth="250.0" promptText="Select Genre" style="-fx-background-color: #404040; -fx-prompt-text-fill: #AAAAAA;" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                        <!-- Row 3: Duration -->
                        <Label style="-fx-text-fill: #FFFFFF;" text="Duration (min):" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                        <TextField promptText="e.g., 120" style="-fx-background-color: #404040; -fx-text-fill: #FFFFFF; -fx-prompt-text-fill: #AAAAAA;" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                        <!-- Row 4: Release Date -->
                        <Label style="-fx-text-fill: #FFFFFF;" text="Release Date:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                        <DatePicker style="-fx-background-color: #404040; -fx-prompt-text-fill: #AAAAAA;" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                        <!-- Row 5: Status -->
                        <Label style="-fx-text-fill: #FFFFFF;" text="Status:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                        <ComboBox prefWidth="250.0" promptText="Select Status (e.g., Active, Coming Soon)" style="-fx-background-color: #404040; -fx-prompt-text-fill: #AAAAAA;" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                        <!-- Row 6: Synopsis / Description -->
                        <Label style="-fx-text-fill: #FFFFFF;" text="Synopsis:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                        <TextArea prefHeight="100.0" promptText="Briefly describe the movie plot and highlights..." style="-fx-background-color: #404040; -fx-text-fill: #FFFFFF; -fx-prompt-text-fill: #AAAAAA;" GridPane.columnIndex="1" GridPane.rowIndex="5" VBox.vgrow="ALWAYS" />

                        <!-- Row 7: Poster Image Upload -->
                        <Label style="-fx-text-fill: #FFFFFF;" text="Poster Image:" GridPane.columnIndex="0" GridPane.rowIndex="6" />
                        <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="6">
                            <TextField editable="false" promptText="No file selected..." style="-fx-background-color: #404040; -fx-text-fill: #FFFFFF; -fx-prompt-text-fill: #AAAAAA;" HBox.hgrow="ALWAYS" />
                            <Button style="-fx-background-color: #FFC72C; -fx-text-fill: #000000; -fx-font-weight: bold; -fx-background-radius: 5;" text="Browse..." /> <!-- Yellow Highlight -->
                        </HBox>

                        <!-- Row 8: Action Buttons -->
                        <HBox alignment="CENTER_RIGHT" spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="7">
                            <Button onAction="#handleCancel" style="-fx-background-color: #AAAAAA; -fx-text-fill: #000000; -fx-font-weight: bold; -fx-padding: 8 20; -fx-background-radius: 5;" text="Cancel" />
                            <Button onAction="#handleSaveMovie" style="-fx-background-color: #FF0000; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-padding: 8 20; -fx-background-radius: 5;" text="Save Movie" /> <!-- Red Highlight -->
                        </HBox>
                  <rowConstraints>
                     <RowConstraints />
                     <RowConstraints />
                     <RowConstraints />
                     <RowConstraints />
                     <RowConstraints />
                     <RowConstraints />
                     <RowConstraints />
                     <RowConstraints />
                  </rowConstraints>

                    </GridPane>

                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
