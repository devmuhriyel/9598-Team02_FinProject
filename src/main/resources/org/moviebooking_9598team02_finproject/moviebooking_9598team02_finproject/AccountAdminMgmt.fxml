<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #292929;"
            xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.moviebooking_9598team02_finproject.moviebooking_9598team02_finproject.Client_Java.Admin_Side.CustomerMgmtMVCs.AdminMgmt.AdminMgmtView">

    <center>
        <StackPane>

            <!-- ========== LIST PANEL ========== -->
            <StackPane fx:id="listPanel" visible="true">
                <BorderPane>
                    <top>
                        <VBox spacing="15.0" style="-fx-background-color: #292929;">
                            <padding>
                                <Insets top="20.0" right="20.0" bottom="15.0" left="20.0"/>
                            </padding>

                            <Label style="-fx-text-fill: #FFFFFF; -fx-font-weight: bold;" text="Admin Management">
                                <font><Font name="SansSerif Bold" size="22.0" /></font>
                            </Label>
                            <Label style="-fx-text-fill: #AAAAAA;" text="View, search, and manage administrator accounts.">
                                <font><Font name="SansSerif Regular" size="14.0" /></font>
                            </Label>

                            <HBox spacing="10.0" alignment="CENTER_LEFT" style="-fx-background-color: #1A1A1A; -fx-background-radius: 8; -fx-padding: 15;">
                                <TextField fx:id="searchField" promptText="Search by username, email, name, or Admin ID..."
                                           HBox.hgrow="ALWAYS" prefWidth="400.0"
                                           style="-fx-background-color: #404040; -fx-text-fill: #FFFFFF; -fx-prompt-text-fill: #AAAAAA;"/>
                                <Button fx:id="searchButton" text="Search"
                                        style="-fx-background-color: #ff2525; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-background-radius: 5;"
                                        prefWidth="100.0"/>
                                <Button fx:id="refreshButton" text="Refresh"
                                        style="-fx-background-color: #404040; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-background-radius: 5;"
                                        prefWidth="100.0"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button fx:id="createButton" text="+ Create Admin"
                                        style="-fx-background-color: #4CAF50; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-background-radius: 5;"
                                        prefWidth="130.0"/>
                            </HBox>

                            <Text fx:id="listMessageText" visible="false" style="-fx-fill: #ff2525;"/>
                        </VBox>
                    </top>

                    <center>
                        <VBox style="-fx-background-color: #292929;">
                            <padding>
                                <Insets top="10.0" right="20.0" bottom="10.0" left="20.0"/>
                            </padding>

                            <VBox spacing="10.0" style="-fx-background-color: #1A1A1A; -fx-background-radius: 8; -fx-padding: 20;" VBox.vgrow="ALWAYS">
                                <Label text="Administrator Accounts" style="-fx-text-fill: #FFFFFF; -fx-font-weight: bold;">
                                    <font><Font name="SansSerif Bold" size="16.0" /></font>
                                </Label>

                                <TableView fx:id="adminTable" VBox.vgrow="ALWAYS"
                                           style="-fx-background-color: #292929; -fx-control-inner-background: #292929;">
                                    <columns>
                                        <TableColumn fx:id="colAdminId" text="Admin ID" prefWidth="80.0"/>
                                        <TableColumn fx:id="colUsername" text="Username" prefWidth="150.0"/>
                                        <TableColumn fx:id="colEmail" text="Email" prefWidth="250.0"/>
                                        <TableColumn fx:id="colFullName" text="Full Name" prefWidth="200.0"/>
                                        <TableColumn fx:id="colPhoneNumber" text="Phone" prefWidth="130.0"/>
                                    </columns>
                                    <placeholder>
                                        <Label style="-fx-text-fill: #AAAAAA;" text="No admins found."/>
                                    </placeholder>
                                </TableView>

                                <HBox spacing="10.0" alignment="CENTER_LEFT">
                                    <Label text="Double-click a row to view details" style="-fx-text-fill: #AAAAAA; -fx-font-size: 12px;"/>
                                </HBox>
                            </VBox>
                        </VBox>
                    </center>
                </BorderPane>
            </StackPane>

            <!-- ========== DETAIL PANEL - SIDE BY SIDE ========== -->
            <StackPane fx:id="detailPanel" visible="false">
                <ScrollPane fitToWidth="true" style="-fx-background: #292929; -fx-background-color: #292929;">
                    <VBox spacing="20" style="-fx-background-color: #292929; -fx-padding: 30;">

                        <!-- Header -->
                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <Button fx:id="backToListButton" text="← Back to List"
                                    style="-fx-background-color: #404040; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-background-radius: 5;"/>
                            <Label text="Admin Details" style="-fx-text-fill: #FFFFFF; -fx-font-size: 22; -fx-font-weight: bold;"/>
                        </HBox>

                        <!-- Message Area -->
                        <Text fx:id="detailMessageText" visible="false" style="-fx-fill: #4CAF50; -fx-font-size: 14; -fx-font-weight: bold;"/>

                        <!-- Two Column Layout -->
                        <HBox spacing="20" VBox.vgrow="ALWAYS">

                            <!-- LEFT COLUMN: Basic Information -->
                            <VBox spacing="15" style="-fx-background-color: #1A1A1A; -fx-background-radius: 8; -fx-padding: 25;" HBox.hgrow="ALWAYS">
                                <Label text="Basic Information" style="-fx-text-fill: #FFFFFF; -fx-font-size: 18; -fx-font-weight: bold;"/>

                                <Separator style="-fx-background-color: #404040;"/>

                                <!-- Admin ID (Read-only) -->
                                <VBox spacing="5">
                                    <Label text="Admin ID" style="-fx-text-fill: #AAAAAA; -fx-font-size: 12;"/>
                                    <Label fx:id="detailAdminIdLabel" text="1" style="-fx-text-fill: #FFFFFF; -fx-font-size: 16; -fx-font-weight: bold;"/>
                                </VBox>

                                <!-- Username (Read-only) -->
                                <VBox spacing="5">
                                    <Label text="Username" style="-fx-text-fill: #AAAAAA; -fx-font-size: 12;"/>
                                    <Label fx:id="detailUsernameLabel" text="username" style="-fx-text-fill: #FFFFFF; -fx-font-size: 16; -fx-font-weight: bold;"/>
                                </VBox>

                                <!-- Email (Read-only) -->
                                <VBox spacing="5">
                                    <Label text="Email Address" style="-fx-text-fill: #AAAAAA; -fx-font-size: 12;"/>
                                    <Label fx:id="detailEmailLabel" text="email@example.com" style="-fx-text-fill: #FFFFFF; -fx-font-size: 14;"/>
                                </VBox>

                                <Separator style="-fx-background-color: #404040;"/>

                                <!-- Full Name (Editable) -->
                                <VBox spacing="5">
                                    <Label text="Full Name" style="-fx-text-fill: #AAAAAA; -fx-font-size: 12;"/>
                                    <TextField fx:id="detailFullNameField" promptText="Enter full name"
                                               style="-fx-background-color: #404040; -fx-text-fill: #FFFFFF; -fx-prompt-text-fill: #777; -fx-font-size: 14;"/>
                                </VBox>

                                <!-- Phone Number (Editable) -->
                                <VBox spacing="5">
                                    <Label text="Phone Number" style="-fx-text-fill: #AAAAAA; -fx-font-size: 12;"/>
                                    <TextField fx:id="detailPhoneField" promptText="Enter phone number"
                                               style="-fx-background-color: #404040; -fx-text-fill: #FFFFFF; -fx-prompt-text-fill: #777; -fx-font-size: 14;"/>
                                </VBox>

                                <!-- Save Profile Button -->
                                <Button fx:id="saveButton" text="💾 Save Profile" prefHeight="40"
                                        style="-fx-background-color: #4CAF50; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-background-radius: 5; -fx-font-size: 14;"/>
                            </VBox>

                            <!-- RIGHT COLUMN: Actions -->
                            <VBox spacing="20" style="-fx-background-color: #1A1A1A; -fx-background-radius: 8; -fx-padding: 25;" prefWidth="420" HBox.hgrow="NEVER">
                                <Label text="Actions" style="-fx-text-fill: #FFFFFF; -fx-font-size: 18; -fx-font-weight: bold;"/>

                                <Separator style="-fx-background-color: #404040;"/>

                                <!-- Change Email Section -->
                                <VBox spacing="10" style="-fx-background-color: #252525; -fx-padding: 15; -fx-background-radius: 5;">
                                    <Label text="📧 Change Email Address" style="-fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-font-size: 14;"/>

                                    <VBox spacing="5">
                                        <Label text="New Email" style="-fx-text-fill: #AAAAAA; -fx-font-size: 12;"/>
                                        <TextField fx:id="newEmailField" promptText="Enter new email address"
                                                   style="-fx-background-color: #333; -fx-text-fill: #FFFFFF; -fx-prompt-text-fill: #777;"/>
                                    </VBox>

                                    <VBox spacing="5">
                                        <Label text="Target Admin's Password" style="-fx-text-fill: #AAAAAA; -fx-font-size: 12;"/>
                                        <PasswordField fx:id="emailPasswordField" promptText="Enter this admin's password"
                                                       style="-fx-background-color: #333; -fx-text-fill: #FFFFFF; -fx-prompt-text-fill: #777;"/>
                                    </VBox>

                                    <Button fx:id="submitEmailButton" text="Update Email" prefHeight="35"
                                            style="-fx-background-color: #2196F3; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-background-radius: 5;"/>
                                </VBox>

                                <!-- Change Password Section -->
                                <VBox spacing="10" style="-fx-background-color: #252525; -fx-padding: 15; -fx-background-radius: 5;">
                                    <Label text="🔐 Change Password" style="-fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-font-size: 14;"/>

                                    <VBox spacing="5">
                                        <Label text="Current Password" style="-fx-text-fill: #AAAAAA; -fx-font-size: 12;"/>
                                        <PasswordField fx:id="oldPasswordField" promptText="Enter current password"
                                                       style="-fx-background-color: #333; -fx-text-fill: #FFFFFF; -fx-prompt-text-fill: #777;"/>
                                    </VBox>

                                    <VBox spacing="5">
                                        <Label text="New Password" style="-fx-text-fill: #AAAAAA; -fx-font-size: 12;"/>
                                        <PasswordField fx:id="newPasswordField" promptText="Min 6 characters"
                                                       style="-fx-background-color: #333; -fx-text-fill: #FFFFFF; -fx-prompt-text-fill: #777;"/>
                                    </VBox>

                                    <VBox spacing="5">
                                        <Label text="Confirm New Password" style="-fx-text-fill: #AAAAAA; -fx-font-size: 12;"/>
                                        <PasswordField fx:id="confirmPasswordField" promptText="Re-enter new password"
                                                       style="-fx-background-color: #333; -fx-text-fill: #FFFFFF; -fx-prompt-text-fill: #777;"/>
                                    </VBox>

                                    <Button fx:id="submitPasswordButton" text="Change Password" prefHeight="35"
                                            style="-fx-background-color: #FF9800; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-background-radius: 5;"/>
                                </VBox>

                                <Separator style="-fx-background-color: #404040;"/>

                                <!-- Danger Zone -->
                                <VBox spacing="10" style="-fx-background-color: #3A1A1A; -fx-padding: 15; -fx-background-radius: 5; -fx-border-color: #8B0000; -fx-border-width: 2; -fx-border-radius: 5;">
                                    <Label text="⚠️ Danger Zone" style="-fx-text-fill: #FF6B6B; -fx-font-weight: bold; -fx-font-size: 14;"/>
                                    <Label text="Permanently delete this administrator account. This action cannot be undone."
                                           style="-fx-text-fill: #AAAAAA; -fx-font-size: 12; -fx-wrap-text: true;" wrapText="true"/>
                                    <Button fx:id="deleteButton" text="🗑️ Delete Admin Account" prefHeight="35"
                                            style="-fx-background-color: #F44336; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-background-radius: 5;"/>
                                </VBox>

                            </VBox>

                        </HBox>

                    </VBox>
                </ScrollPane>
            </StackPane>

            <!-- ========== CREATE PANEL ========== -->
            <StackPane fx:id="createPanel" visible="false">
                <ScrollPane fitToWidth="true" style="-fx-background: #292929; -fx-background-color: #292929;">
                    <VBox spacing="20" style="-fx-background-color: #292929; -fx-padding: 30;">

                        <!-- Header -->
                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <Button fx:id="createCancelButton" text="← Cancel"
                                    style="-fx-background-color: #404040; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-background-radius: 5;"/>
                            <Label text="Create New Admin" style="-fx-text-fill: #FFFFFF; -fx-font-size: 22; -fx-font-weight: bold;"/>
                        </HBox>

                        <!-- Form Card -->
                        <VBox spacing="15" style="-fx-background-color: #1A1A1A; -fx-background-radius: 8; -fx-padding: 25;">
                            <Label text="Admin Information" style="-fx-text-fill: #FFFFFF; -fx-font-size: 16; -fx-font-weight: bold;"/>

                            <GridPane hgap="20" vgap="15">
                                <Label text="Username:*" GridPane.columnIndex="0" GridPane.rowIndex="0"
                                       style="-fx-text-fill: #AAAAAA; -fx-font-weight: bold;"/>
                                <TextField fx:id="createUsernameField" GridPane.columnIndex="1" GridPane.rowIndex="0"
                                           promptText="Enter username" prefWidth="300"
                                           style="-fx-background-color: #404040; -fx-text-fill: #FFFFFF; -fx-prompt-text-fill: #888888;"/>

                                <Label text="Email:*" GridPane.columnIndex="0" GridPane.rowIndex="1"
                                       style="-fx-text-fill: #AAAAAA; -fx-font-weight: bold;"/>
                                <TextField fx:id="createEmailField" GridPane.columnIndex="1" GridPane.rowIndex="1"
                                           promptText="Enter email address" prefWidth="300"
                                           style="-fx-background-color: #404040; -fx-text-fill: #FFFFFF; -fx-prompt-text-fill: #888888;"/>

                                <Label text="Password:*" GridPane.columnIndex="0" GridPane.rowIndex="2"
                                       style="-fx-text-fill: #AAAAAA; -fx-font-weight: bold;"/>
                                <PasswordField fx:id="createPasswordField" GridPane.columnIndex="1" GridPane.rowIndex="2"
                                               promptText="Enter password (min. 6 characters)" prefWidth="300"
                                               style="-fx-background-color: #404040; -fx-text-fill: #FFFFFF; -fx-prompt-text-fill: #888888;"/>

                                <Label text="Confirm Password:*" GridPane.columnIndex="0" GridPane.rowIndex="3"
                                       style="-fx-text-fill: #AAAAAA; -fx-font-weight: bold;"/>
                                <PasswordField fx:id="createConfirmPasswordField" GridPane.columnIndex="1" GridPane.rowIndex="3"
                                               promptText="Re-enter password" prefWidth="300"
                                               style="-fx-background-color: #404040; -fx-text-fill: #FFFFFF; -fx-prompt-text-fill: #888888;"/>

                                <Label text="Full Name:" GridPane.columnIndex="0" GridPane.rowIndex="4"
                                       style="-fx-text-fill: #AAAAAA; -fx-font-weight: bold;"/>
                                <TextField fx:id="createFullNameField" GridPane.columnIndex="1" GridPane.rowIndex="4"
                                           promptText="Enter full name (optional)" prefWidth="300"
                                           style="-fx-background-color: #404040; -fx-text-fill: #FFFFFF; -fx-prompt-text-fill: #888888;"/>

                                <Label text="Phone:" GridPane.columnIndex="0" GridPane.rowIndex="5"
                                       style="-fx-text-fill: #AAAAAA; -fx-font-weight: bold;"/>
                                <TextField fx:id="createPhoneField" GridPane.columnIndex="1" GridPane.rowIndex="5"
                                           promptText="Enter phone number (optional)" prefWidth="300"
                                           style="-fx-background-color: #404040; -fx-text-fill: #FFFFFF; -fx-prompt-text-fill: #888888;"/>
                            </GridPane>

                            <Label text="* Required fields" style="-fx-text-fill: #888888; -fx-font-size: 12;"/>
                        </VBox>

                        <!-- Submit Button -->
                        <HBox spacing="10">
                            <Button fx:id="createSaveButton" text="Create Admin" prefWidth="150"
                                    style="-fx-background-color: #4CAF50; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-background-radius: 5; -fx-font-size: 14;"/>
                        </HBox>

                        <Text fx:id="createMessageText" visible="false" style="-fx-fill: #ff2525; -fx-font-size: 14;"/>
                    </VBox>
                </ScrollPane>
            </StackPane>

        </StackPane>
    </center>
</BorderPane>
