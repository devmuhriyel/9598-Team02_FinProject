<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="720.0" prefWidth="1080.0" style="-fx-background-color: #292929;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.moviebooking_9598team02_finproject.moviebooking_9598team02_finproject.Client_Java.Admin_Side.BookingsMVCs.AdminBookingView">

    <top>
        <VBox spacing="15.0" style="-fx-background-color: #292929; -fx-padding: 20;">
            <HBox alignment="CENTER_LEFT" spacing="20.0">
                <Label text="Booking Management" textFill="WHITE">
                    <font><Font name="SansSerif Bold" size="24.0" /></font>
                </Label>
                <Label fx:id="lblStatus" text="Ready" textFill="#bbbbbb">
                    <font><Font name="SansSerif Italic" size="14.0" /></font>
                </Label>
            </HBox>

            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <TextField fx:id="searchField" promptText="Search Booking ID, Customer ID, or Status..."
                           prefWidth="400.0"
                           style="-fx-background-color: #404040; -fx-text-fill: white; -fx-prompt-text-fill: #888888;" />

                <Button fx:id="btnSearch" text="Search"
                        style="-fx-background-color: #007ACC; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" />

                <Button fx:id="btnClearSearch" text="Clear"
                        style="-fx-background-color: #444444; -fx-text-fill: white; -fx-cursor: hand;" />
            </HBox>
        </VBox>
    </top>

    <center>
        <TableView fx:id="bookingTable" style="-fx-background-color: #333333; -fx-base: #333333; -fx-control-inner-background: #333333; -fx-text-fill: white;">
            <columns>
                <TableColumn fx:id="colId" prefWidth="80.0" text="ID" />
                <TableColumn fx:id="colCustId" prefWidth="100.0" text="Customer ID" />
                <TableColumn fx:id="colSchedId" prefWidth="100.0" text="Schedule ID" />
                <TableColumn fx:id="colPrice" prefWidth="100.0" text="Total Price" />
                <TableColumn fx:id="colStatus" prefWidth="120.0" text="Status" />
                <TableColumn fx:id="colDate" prefWidth="150.0" text="Created At" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <BorderPane.margin>
                <Insets bottom="20.0" left="20.0" right="20.0" />
            </BorderPane.margin>
        </TableView>
    </center>

    <right>
        <VBox alignment="TOP_CENTER" prefWidth="250.0" spacing="15.0" style="-fx-background-color: #1A1A1A; -fx-padding: 20;">
            <Label text="Actions" textFill="#ff2525">
                <font><Font name="SansSerif Bold" size="18.0" /></font>
            </Label>

            <Label text="Select a booking to modify:" textFill="WHITE" wrapText="true" style="-fx-font-size: 12;" />

            <Button fx:id="btnCancelBooking" maxWidth="1.7976931348623157E308" mnemonicParsing="false"
                    style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"
                    text="CANCEL BOOKING">
                <padding><Insets bottom="12" top="12" /></padding>
            </Button>

            <Label text="_________________________" textFill="#444444" />

            <Button fx:id="btnRefresh" maxWidth="1.7976931348623157E308" mnemonicParsing="false"
                    style="-fx-background-color: #444444; -fx-text-fill: white; -fx-cursor: hand;"
                    text="Refresh List">
                <padding><Insets bottom="10" top="10" /></padding>
            </Button>
        </VBox>
    </right>

</BorderPane>