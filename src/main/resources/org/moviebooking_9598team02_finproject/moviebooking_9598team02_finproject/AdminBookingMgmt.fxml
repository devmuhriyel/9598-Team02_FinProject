<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="720.0" prefWidth="1080.0" style="-fx-background-color: #292929;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.moviebooking_9598team02_finproject.moviebooking_9598team02_finproject.Client_Java.Admin_Side.BookingsMVCs.AdminBookingView">

    <top>
        <VBox spacing="15.0" style="-fx-background-color: #292929; -fx-padding: 20;">
            <HBox alignment="CENTER_LEFT" spacing="20.0">
                <Label text="Booking Management" textFill="WHITE">
                    <font><Font name="SansSerif Bold" size="24.0" /></font>
                </Label>
                <Label fx:id="lblStatus" text="Ready" textFill="#bbbbbb">
                    <font><Font name="SansSerif Italic" size="14.0" /></font>
                </Label>
            </HBox>

            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <TextField fx:id="searchField" promptText="Search ID or Customer..."
                           prefWidth="400.0"
                           style="-fx-background-color: #404040; -fx-text-fill: white; -fx-prompt-text-fill: #888888;" />

                <Button fx:id="btnRefresh" text="Refresh Table"
                        style="-fx-background-color: #444444; -fx-text-fill: white; -fx-cursor: hand;" />
            </HBox>
        </VBox>
    </top>

    <center>
        <TableView fx:id="bookingTable" style="-fx-background-color: #333333; -fx-base: #333333; -fx-control-inner-background: #333333; -fx-text-fill: white;">
            <columns>
                <TableColumn fx:id="colId" prefWidth="80.0" text="ID" />
                <TableColumn fx:id="colCustId" prefWidth="100.0" text="Customer ID" />
                <TableColumn fx:id="colSchedId" prefWidth="100.0" text="Schedule ID" />
                <TableColumn fx:id="colPrice" prefWidth="100.0" text="Total Price" />
                <TableColumn fx:id="colStatus" prefWidth="120.0" text="Status" />
                <TableColumn fx:id="colDate" prefWidth="150.0" text="Created At" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <BorderPane.margin>
                <Insets bottom="20.0" left="20.0" right="20.0" />
            </BorderPane.margin>
        </TableView>
    </center>

    <right>
        <VBox prefWidth="280.0" spacing="15.0" style="-fx-background-color: #1A1A1A; -fx-padding: 20;">
            <Label text="FILTER RESULTS" textFill="#ff2525">
                <font><Font name="SansSerif Bold" size="16.0" /></font>
            </Label>

            <Label text="By Status" textFill="#aaaaaa" style="-fx-font-size: 11px; -fx-font-weight: bold;" />
            <ComboBox fx:id="comboStatus" prefWidth="240.0" promptText="All Statuses" style="-fx-base: #444444;" />

            <Label text="By Schedule ID" textFill="#aaaaaa" style="-fx-font-size: 11px; -fx-font-weight: bold;" />
            <ComboBox fx:id="comboSchedule" prefWidth="240.0" promptText="All Schedules" style="-fx-base: #444444;" />

            <Label text="By Movie ID (via Schedule)" textFill="#aaaaaa" style="-fx-font-size: 11px; -fx-font-weight: bold;" />
            <ComboBox fx:id="comboMovie" prefWidth="240.0" promptText="All Movies" style="-fx-base: #444444;" />

            <Button fx:id="btnClearFilters" maxWidth="Infinity"
                    style="-fx-background-color: #ff2525; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"
                    text="RESET FILTERS">
                <VBox.margin><Insets top="20" /></VBox.margin>
            </Button>
        </VBox>
    </right>

</BorderPane>