<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<!-- fx:controller points to CustomerMovieView -->
<BorderPane prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #292929;"
            xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.moviebooking_9598team02_finproject.moviebooking_9598team02_finproject.Client_Java.Customer_Side.MovieMVCs.CustomerMovieView">

    <center>
        <StackPane fx:id="rootContentStack" prefHeight="720.0" prefWidth="1280.0">
            <VBox fx:id="movieView" spacing="20.0" style="-fx-background-color: #292929;">
                <padding>
                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                </padding>

                <!-- Header Section -->
                <VBox spacing="10.0">
                    <Label style="-fx-text-fill: #FFFFFF; -fx-font-weight: bold;" text="Browse Movies">
                        <font><Font name="SansSerif Bold" size="28.0" /></font>
                    </Label>
                    <Label style="-fx-text-fill: #AAAAAA;" text="Discover your next favorite film">
                        <font><Font name="SansSerif Regular" size="14.0" /></font>
                    </Label>
                </VBox>

                <!-- Search and Filter Section -->
                <VBox spacing="15.0" style="-fx-padding: 20; -fx-background-color: #1A1A1A; -fx-background-radius: 10;">
                    <Label style="-fx-text-fill: #FFD700; -fx-font-weight: bold; -fx-font-size: 16;" text="Search &amp; Filters" />

                    <!-- Search Bar -->
                    <HBox alignment="CENTER_LEFT" spacing="15.0">
                        <Label style="-fx-text-fill: #FFFFFF; -fx-font-weight: bold;" text="Search:" />
                        <TextField fx:id="searchField" prefWidth="400.0" promptText="Enter movie title..."
                                   style="-fx-background-color: #333333; -fx-text-fill: #FFFFFF; -fx-prompt-text-fill: #888888; -fx-padding: 10;"
                                   HBox.hgrow="ALWAYS" />
                        <Button onAction="#handleSearchClick"
                                style="-fx-background-color: #007ACC; -fx-text-fill: WHITE; -fx-font-weight: bold; -fx-padding: 10 25; -fx-cursor: hand;"
                                text="Search" />
                        <Button onAction="#handleClearFiltersClick"
                                style="-fx-background-color: #555555; -fx-text-fill: WHITE; -fx-font-weight: bold; -fx-padding: 10 25; -fx-cursor: hand;"
                                text="Clear All" />
                    </HBox>

                    <!-- Filter Options -->
                    <HBox alignment="CENTER_LEFT" spacing="20.0">
                        <!-- Genre Filter -->
                        <VBox spacing="5.0">
                            <Label style="-fx-text-fill: #FFFFFF; -fx-font-size: 12;" text="Genre:" />
                            <ComboBox fx:id="genreFilterComboBox" prefWidth="180.0" promptText="All Genres"
                                      style="-fx-background-color: #333333; -fx-text-fill: #FFFFFF;" />
                        </VBox>

                        <!-- Rating Filter -->
                        <VBox spacing="5.0">
                            <Label style="-fx-text-fill: #FFFFFF; -fx-font-size: 12;" text="Min Rating:" />
                            <ComboBox fx:id="ratingFilterComboBox" prefWidth="120.0" promptText="Any"
                                      style="-fx-background-color: #333333;" />
                        </VBox>

                        <!-- Date Filter -->
                        <VBox spacing="5.0">
                            <Label style="-fx-text-fill: #FFFFFF; -fx-font-size: 12;" text="Showing Date:" />
                            <DatePicker fx:id="dateFilterPicker" prefWidth="180.0" promptText="Select date"
                                        style="-fx-background-color: #333333;" />
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Status Message -->
                <Label fx:id="statusMessageLabel" alignment="CENTER" maxWidth="1.7976931348623157E308"
                       style="-fx-text-fill: #00CC66; -fx-font-weight: bold;" text=" " visible="false">
                    <font><Font name="SansSerif Regular" size="13.0" /></font>
                </Label>

                <!-- Main Content Area (Movie Cards + Details Panel) -->
                <HBox spacing="20.0" VBox.vgrow="ALWAYS">

                    <!-- Movie Cards Container -->
                    <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                        <Label style="-fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-font-size: 16;" text="Available Movies" />

                        <ScrollPane fx:id="movieScrollPane" fitToWidth="true"
                                    style="-fx-background-color: transparent; -fx-background: #292929;"
                                    VBox.vgrow="ALWAYS">
                            <FlowPane fx:id="movieCardsContainer" hgap="20.0" vgap="20.0"
                                      style="-fx-background-color: #292929; -fx-padding: 10;">
                                <!-- Movie cards will be added dynamically here -->
                            </FlowPane>
                        </ScrollPane>
                    </VBox>

                    <!-- Movie Details Panel (Initially Hidden) -->
                    <VBox fx:id="movieDetailsPanel" prefWidth="400.0" spacing="20.0" visible="false"
                          style="-fx-padding: 25; -fx-background-color: #1A1A1A; -fx-background-radius: 10; -fx-border-color: #FFD700; -fx-border-radius: 10; -fx-border-width: 2;">

                        <Label style="-fx-text-fill: #FFD700; -fx-font-weight: bold; -fx-font-size: 18;" text="Movie Details" />

                        <!-- Movie Poster -->
                        <VBox alignment="TOP_CENTER" spacing="10.0">
                            <ImageView fx:id="moviePosterImageView" fitHeight="250.0" fitWidth="180.0" preserveRatio="true"
                                       style="-fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.8), 10, 0, 0, 0);">
                            </ImageView>
                        </VBox>

                        <!-- Movie Information -->
                        <VBox spacing="15.0">
                            <VBox spacing="5.0">
                                <Label style="-fx-text-fill: #AAAAAA; -fx-font-size: 12;" text="TITLE" />
                                <Label fx:id="movieTitleLabel" style="-fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-font-size: 20; -fx-wrap-text: true;"
                                       text="Movie Title" wrapText="true" />
                            </VBox>

                            <VBox spacing="5.0">
                                <Label style="-fx-text-fill: #AAAAAA; -fx-font-size: 12;" text="RATING" />
                                <Label fx:id="movieRatingLabel" style="-fx-text-fill: #FFD700; -fx-font-weight: bold; -fx-font-size: 16;"
                                       text="⭐ 0/10" />
                            </VBox>

                            <VBox spacing="5.0">
                                <Label style="-fx-text-fill: #AAAAAA; -fx-font-size: 12;" text="GENRES" />
                                <Label fx:id="movieGenresLabel" style="-fx-text-fill: #FFFFFF; -fx-font-size: 14; -fx-wrap-text: true;"
                                       text="Genres" wrapText="true" />
                            </VBox>

                            <VBox spacing="5.0">
                                <Label style="-fx-text-fill: #AAAAAA; -fx-font-size: 12;" text="DESCRIPTION" />
                                <ScrollPane fitToWidth="true" maxHeight="150.0"
                                            style="-fx-background-color: transparent; -fx-background: transparent;">
                                    <Label fx:id="movieDescriptionLabel" style="-fx-text-fill: #CCCCCC; -fx-font-size: 13; -fx-wrap-text: true;"
                                           text="Movie description" wrapText="true" />
                                </ScrollPane>
                            </VBox>
                        </VBox>

                        <!-- Action Buttons -->
                        <VBox spacing="15.0" style="-fx-padding: 20 0 0 0;">
                            <Button fx:id="viewSchedulesButton" maxWidth="1.7976931348623157E308"
                                    style="-fx-background-color: #00CC66; -fx-text-fill: #000000; -fx-font-weight: bold; -fx-padding: 15; -fx-font-size: 14; -fx-cursor: hand;"
                                    text="View Schedules" />
                            <Button fx:id="backButton" maxWidth="1.7976931348623157E308"
                                    style="-fx-background-color: #555555; -fx-text-fill: WHITE; -fx-font-weight: bold; -fx-padding: 12; -fx-font-size: 13; -fx-cursor: hand;"
                                    text="Back to Movies" />
                        </VBox>
                    </VBox>

                </HBox>

                <!-- Bottom Navigation -->
                <HBox alignment="CENTER_RIGHT" spacing="15.0" style="-fx-padding: 10 0 0 0;">
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="homeButton"
                            style="-fx-background-color: #007ACC; -fx-text-fill: WHITE; -fx-font-weight: bold; -fx-padding: 12 30; -fx-font-size: 13; -fx-cursor: hand;"
                            text="🏠 Home" />
                </HBox>

            </VBox>
        </StackPane>
    </center>
</BorderPane>