// Admin.idl - Administrative operations
#include "Common.idl"

module MovieBookingAdmin {

    // Import common types
    typedef MovieBookingCommon::Movie Movie;
    typedef MovieBookingCommon::MovieList MovieList;
    typedef MovieBookingCommon::MovieSchedule MovieSchedule;
    typedef MovieBookingCommon::MovieScheduleList MovieScheduleList;
    typedef MovieBookingCommon::Schedule Schedule;
    typedef MovieBookingCommon::ScheduleList ScheduleList;
    typedef MovieBookingCommon::Booking Booking;
    typedef MovieBookingCommon::BookingList BookingList;
    typedef MovieBookingCommon::Customer Customer;
    typedef MovieBookingCommon::CustomerList CustomerList;
    typedef MovieBookingCommon::Admin Admin;
    typedef MovieBookingCommon::AdminList AdminList;
    typedef MovieBookingCommon::Seat Seat;
    typedef MovieBookingCommon::SeatList SeatList;
    typedef MovieBookingCommon::ScheduleListSeat ScheduleListSeat;
    typedef MovieBookingCommon::ScheduleListSeatList ScheduleListSeatList;
    typedef MovieBookingCommon::Genre Genre;
    typedef MovieBookingCommon::GenreList GenreList;
    typedef MovieBookingCommon::GenreNameList GenreNameList;
    typedef MovieBookingCommon::IdList IdList;
    typedef MovieBookingCommon::Payment Payment;
    typedef MovieBookingCommon::PaymentList PaymentList;
    typedef MovieBookingCommon::BookingDetails BookingDetails;
    typedef MovieBookingCommon::BookingDetailsList BookingDetailsList;
    typedef MovieBookingCommon::ScheduleDetails ScheduleDetails;
    typedef MovieBookingCommon::ScheduleDetailsList ScheduleDetailsList;
    typedef MovieBookingCommon::PaymentDetails PaymentDetails;
    typedef MovieBookingCommon::PaymentDetailsList PaymentDetailsList;

    // ==================== ADMIN INTERFACE ====================

    interface AdminService {

        // ===== ADMIN AUTHENTICATION =====

        // Admin login - returns admin info and session token
        // If admin is already logged in from another device, old session is invalidated
        MovieBookingCommon::AdminLoginResponse loginAdmin(in string username, in string password) raises (MovieBookingCommon::AuthenticationException);

        // Admin logout - requires session token for authentication
        void logoutAdmin(in long adminId, in string sessionToken) raises (MovieBookingCommon::AuthenticationException);

        // ===== GENRE MANAGEMENT =====

        // Create a new genre
        long addGenre(in long adminId, in string sessionToken, in string genreName, in string genreDescription) raises (MovieBookingCommon::AuthenticationException, MovieBookingCommon::InvalidInputException);

        // Update genre details
        void updateGenre(in long adminId, in string sessionToken, in long genreId, in string genreName, in string genreDescription) raises (MovieBookingCommon::AuthenticationException);

        // Delete a genre (only if no movies are using it)
        void deleteGenre(in long adminId, in string sessionToken, in long genreId) raises (MovieBookingCommon::AuthenticationException);

        // Get all genres
        GenreList getAllGenres(in long adminId, in string sessionToken) raises (MovieBookingCommon::AuthenticationException);

        // Get a specific genre
        Genre getGenreById(in long adminId, in string sessionToken, in long genreId) raises (MovieBookingCommon::AuthenticationException);

        // ===== MOVIE MANAGEMENT =====

        // Add a new movie to the system with genres
        // Returns the newly created movie ID
        long addMovie(in long adminId, in string sessionToken, in string movieTitle, in IdList genreIds, in string movieDescription, in long movieRating, in string moviePosterURL) raises (MovieBookingCommon::AuthenticationException, MovieBookingCommon::InvalidInputException);

        // Update movie title
        void updateMovieTitle(in long adminId, in string sessionToken, in long movieId, in string newTitle) raises (MovieBookingCommon::AuthenticationException, MovieBookingCommon::MovieNotFoundException);

        // Update movie genres (replaces all existing genres)
        void updateMovieGenres(in long adminId, in string sessionToken, in long movieId, in IdList newGenreIds) raises (MovieBookingCommon::AuthenticationException, MovieBookingCommon::MovieNotFoundException);

        // Add a single genre to a movie
        void addGenreToMovie(in long adminId, in string sessionToken, in long movieId, in long genreId) raises (MovieBookingCommon::AuthenticationException, MovieBookingCommon::MovieNotFoundException);

        // Remove a single genre from a movie
        void removeGenreFromMovie(in long adminId, in string sessionToken, in long movieId, in long genreId) raises (MovieBookingCommon::AuthenticationException, MovieBookingCommon::MovieNotFoundException);

        // Get genres for a specific movie
        GenreList getMovieGenres(in long adminId, in string sessionToken, in long movieId) raises (MovieBookingCommon::AuthenticationException, MovieBookingCommon::MovieNotFoundException);

        // Update movie description
        void updateMovieDescription(in long adminId, in string sessionToken, in long movieId, in string newDescription) raises (MovieBookingCommon::AuthenticationException, MovieBookingCommon::MovieNotFoundException);

        // Update movie rating
        void updateMovieRating(in long adminId, in string sessionToken, in long movieId, in long newRating) raises (MovieBookingCommon::AuthenticationException, MovieBookingCommon::MovieNotFoundException);

        // Update movie poster URL
        void updateMoviePoster(in long adminId, in string sessionToken, in long movieId, in string newPosterURL) raises (MovieBookingCommon::AuthenticationException, MovieBookingCommon::MovieNotFoundException);

        // Delete a movie (hard delete - also removes all genre associations)
        void deleteMovie(in long adminId, in string sessionToken, in long movieId) raises (MovieBookingCommon::AuthenticationException, MovieBookingCommon::MovieNotFoundException);

        // Get all movies
        MovieList getAllMovies(in long adminId, in string sessionToken) raises (MovieBookingCommon::AuthenticationException);

        // ===== SCHEDULE MANAGEMENT =====

        // Create a new movie schedule (screening time)
        long createMovieSchedule(in long adminId, in string sessionToken, in string screeningDate, in string screeningTime) raises (MovieBookingCommon::AuthenticationException, MovieBookingCommon::InvalidInputException);

        // Link a movie to a schedule (creates Schedule entry)
        long assignMovieToSchedule(in long adminId, in string sessionToken, in long movieId, in long movieScheduleId) raises (MovieBookingCommon::AuthenticationException, MovieBookingCommon::MovieNotFoundException, MovieBookingCommon::ScheduleNotFoundException);

        // Update schedule date/time
        void updateScheduleDateTime(in long adminId, in string sessionToken, in long scheduleId, in string newDate, in string newTime) raises (MovieBookingCommon::AuthenticationException, MovieBookingCommon::ScheduleNotFoundException);

        // Delete a schedule
        void deleteSchedule(in long adminId, in string sessionToken, in long scheduleId) raises (MovieBookingCommon::AuthenticationException, MovieBookingCommon::ScheduleNotFoundException);

        // Get all schedules
        ScheduleList getAllSchedules(in long adminId, in string sessionToken) raises (MovieBookingCommon::AuthenticationException);

        // Get schedules for a specific movie
        ScheduleList getSchedulesByMovie(in long adminId, in string sessionToken, in long movieId) raises (MovieBookingCommon::AuthenticationException, MovieBookingCommon::MovieNotFoundException);

        // ===== SEAT MANAGEMENT =====

        // Add a new seat to the system
        long addSeat(in long adminId, in string sessionToken, in string seatRow, in long seatNumber, in string seatType, in double seatPrice) raises (MovieBookingCommon::AuthenticationException, MovieBookingCommon::InvalidInputException);

        // Update seat price
        void updateSeatPrice(in long adminId, in string sessionToken, in long seatId, in double newPrice) raises (MovieBookingCommon::AuthenticationException);

        // Update seat type
        void updateSeatType(in long adminId, in string sessionToken, in long seatId, in string newType) raises (MovieBookingCommon::AuthenticationException);

        // Delete a seat
        void deleteSeat(in long adminId, in string sessionToken, in long seatId) raises (MovieBookingCommon::AuthenticationException);

        // Get all seats
        SeatList getAllSeats(in long adminId, in string sessionToken) raises (MovieBookingCommon::AuthenticationException);

        // Assign seats to a schedule (when schedule is created)
        long assignSeatToSchedule(in long adminId, in string sessionToken, in long scheduleId, in long seatId, in string status) raises (MovieBookingCommon::AuthenticationException, MovieBookingCommon::ScheduleNotFoundException);

        // Bulk assign all seats to a new schedule
        void initializeScheduleSeats(in long adminId, in string sessionToken, in long scheduleId) raises (MovieBookingCommon::AuthenticationException, MovieBookingCommon::ScheduleNotFoundException);

        // Change seat status for a schedule
        void updateScheduleSeatStatus(in long adminId, in string sessionToken, in long scheduleListSeatId, in string status) raises (MovieBookingCommon::AuthenticationException);

        // Remove seat from schedule (rare, but for flexibility)
        void removeScheduleSeat(in long adminId, in string sessionToken, in long scheduleListSeatId) raises (MovieBookingCommon::AuthenticationException);

        // Get all schedule seats (admin view)
        ScheduleListSeatList getAllScheduleSeats(in long adminId, in string sessionToken, in long scheduleId) raises (MovieBookingCommon::AuthenticationException, MovieBookingCommon::ScheduleNotFoundException);

        // ===== BOOKING MANAGEMENT =====

        // View all bookings in the system
        BookingList getAllBookings(in long adminId, in string sessionToken) raises (MovieBookingCommon::AuthenticationException);

        // Get bookings for a specific movie
        BookingList getBookingsByMovie(in long adminId, in string sessionToken, in long movieId) raises (MovieBookingCommon::AuthenticationException, MovieBookingCommon::MovieNotFoundException);

        // Get bookings for a specific schedule
        BookingList getBookingsBySchedule(in long adminId, in string sessionToken, in long scheduleId) raises (MovieBookingCommon::AuthenticationException, MovieBookingCommon::ScheduleNotFoundException);

        // Get bookings by status
        BookingList getBookingsByStatus(in long adminId, in string sessionToken, in string status) raises (MovieBookingCommon::AuthenticationException);

        // Cancel a booking (admin override)
        void cancelBooking(in long adminId, in string sessionToken, in long bookingId, in string reason) raises (MovieBookingCommon::AuthenticationException, MovieBookingCommon::BookingException);

        // Admin modifies booking
        void updateBookingAdmin(in long adminId, in string sessionToken, in long bookingId, in IdList newScheduleListSeatIds, in string status) raises (MovieBookingCommon::AuthenticationException, MovieBookingCommon::BookingException);

        // Get booking with full details
        BookingDetails getBookingDetailsView(in long adminId, in string sessionToken, in long bookingId) raises (MovieBookingCommon::AuthenticationException, MovieBookingCommon::BookingException);

        // Get all bookings with details
        BookingDetailsList getAllBookingsWithDetails(in long adminId, in string sessionToken) raises (MovieBookingCommon::AuthenticationException);

        // Get schedule with movie info and availability
        ScheduleDetails getScheduleDetailsView(in long adminId, in string sessionToken, in long scheduleId) raises (MovieBookingCommon::AuthenticationException, MovieBookingCommon::ScheduleNotFoundException);

        // Get all schedules with details
        ScheduleDetailsList getAllSchedulesWithDetails(in long adminId, in string sessionToken) raises (MovieBookingCommon::AuthenticationException);

        // Get payment with full context
        PaymentDetails getPaymentDetailsView(in long adminId, in string sessionToken, in long paymentId) raises (MovieBookingCommon::AuthenticationException, MovieBookingCommon::PaymentNotFoundException);

        // Get all payments with details
        PaymentDetailsList getAllPaymentsWithDetails(in long adminId, in string sessionToken) raises (MovieBookingCommon::AuthenticationException);

        // ===== CUSTOMER MANAGEMENT =====
        // View all customers
        CustomerList getAllCustomers(in long adminId, in string sessionToken) raises (MovieBookingCommon::AuthenticationException);

        // Search customers by name or email
        CustomerList searchCustomers(in long adminId, in string sessionToken, in string searchString) raises (MovieBookingCommon::AuthenticationException);

        // Get customer details and booking history
        Customer getCustomerDetails(in long adminId, in string sessionToken, in long customerId) raises (MovieBookingCommon::AuthenticationException);

        // Admin updates customer info
        void updateCustomerInfo(in long adminId, in string sessionToken, in long customerId, in string email, in string phoneNumber, in string fullName) raises (MovieBookingCommon::AuthenticationException);

        // Admin deactivates customer account (with reason)
        void deactivateCustomer(in long adminId, in string sessionToken, in long customerId, in string reason) raises (MovieBookingCommon::AuthenticationException);

        // ===== REPORTS & ANALYTICS =====
        // Generate sales report for a date range
        string generateSalesReport(in long adminId, in string sessionToken, in string startDate, in string endDate) raises (MovieBookingCommon::AuthenticationException);

        // Get total revenue for a movie
        double getMovieRevenue(in long adminId, in string sessionToken, in long movieId) raises (MovieBookingCommon::AuthenticationException, MovieBookingCommon::MovieNotFoundException);

        // Get occupancy rate for a schedule
        double getScheduleOccupancy(in long adminId, in string sessionToken, in long scheduleId) raises (MovieBookingCommon::AuthenticationException, MovieBookingCommon::ScheduleNotFoundException);

        // Get most popular movies (by booking count)
        MovieList getPopularMovies(in long adminId, in string sessionToken, in long top) raises (MovieBookingCommon::AuthenticationException);

        // Get movies by genre (analytics)
        MovieList getMoviesByGenre(in long adminId, in string sessionToken, in long genreId) raises (MovieBookingCommon::AuthenticationException);

        // ===== ADMIN MANAGEMENT =====

        // CREATE - Create new admin (require super admin or existing admin)
        long createAdmin(in long creatorAdminId, in string sessionToken, in string username, in string email, in string password, in string fullName, in string phoneNumber) raises (MovieBookingCommon::AuthenticationException, MovieBookingCommon::InvalidInputException);

        // READ - Get admin by ID
        Admin getAdminById(in long adminId, in string sessionToken, in long requestingAdminId) raises (MovieBookingCommon::AuthenticationException);

        // READ - Get all admins
        AdminList getAllAdmins(in long adminId, in string sessionToken) raises (MovieBookingCommon::AuthenticationException);

        // Search admins
        AdminList searchAdmins(in long adminId, in string sessionToken, in string searchString) raises (MovieBookingCommon::AuthenticationException);

        // Update admin profile
        void updateAdminProfile(in long adminId, in string sessionToken, in string fullName, in string phoneNumber) raises (MovieBookingCommon::AuthenticationException);

        // Update admin email
        void updateAdminEmail(in long adminId, in string sessionToken, in string newEmail, in string password) raises (MovieBookingCommon::AuthenticationException, MovieBookingCommon::InvalidInputException);

        // Change admin password
        void changeAdminPassword(in long adminId, in string sessionToken, in string oldPassword, in string newPassword) raises (MovieBookingCommon::AuthenticationException);

        // Deactivate admin (soft delete)
        void deactivateAdmin(in long superAdminId, in string sessionToken, in long targetAdminId, in string reason) raises (MovieBookingCommon::AuthenticationException);

        // Permanently delete admin (use with caution)
        void deleteAdmin(in long superAdminId, in string sessionToken, in long targetAdminId) raises (MovieBookingCommon::AuthenticationException);

        // ===== PAYMENT PROCESSING =====

        // Get all payments
        PaymentList getAllPayments(in long adminId, in string sessionToken) raises (MovieBookingCommon::AuthenticationException);

        // Get payment by ID
        Payment getPaymentById(in long adminId, in string sessionToken, in long paymentId) raises (MovieBookingCommon::AuthenticationException, MovieBookingCommon::PaymentNotFoundException);

        // Get payments by status
        PaymentList getPaymentsByStatus(in long adminId, in string sessionToken, in string status) raises (MovieBookingCommon::AuthenticationException);

        // Get payments for a booking
        PaymentList getBookingPayments(in long adminId, in string sessionToken, in long bookingId) raises (MovieBookingCommon::AuthenticationException);

        // Update payment status
        void updatePaymentStatus(in long adminId, in string sessionToken, in long paymentId, in string status) raises (MovieBookingCommon::AuthenticationException, MovieBookingCommon::PaymentNotFoundException);

        // Process refund
        void refundPayment(in long adminId, in string sessionToken, in long paymentId, in string reason) raises (MovieBookingCommon::AuthenticationException, MovieBookingCommon::PaymentNotFoundException, MovieBookingCommon::PaymentException);
    };
};