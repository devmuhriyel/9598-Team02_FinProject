// Common.idl - Shared data structures and common operations
module MovieBookingCommon {
    
    // ==================== DATA STRUCTURES (struct) ====================

    // ===== BASE STRUCTS =====

    struct Genre {
        long genreId;
        string genreName;
        string genreDescription;
        string createdAt;
        string updatedAt;
    };

    struct Movie {
        long movieId;
        string movieTitle;
        sequence<string> movieGenres;  // Fetched from movie_genres table
        string movieDescription;
        long movieRating;              // Rating out of 10
        string moviePosterURL;
        long createdByAdmin;
        string createdAt;
        string updatedAt;
    };

    struct MovieSchedule {
        long movieScheduleId;
        string screeningDate;          // Format: "YYYY-MM-DD"
        string screeningTime;          // Format: "HH:MM"
        long createdByAdmin;
        string createdAt;
        string updatedAt;
    };

    struct Schedule {
        long scheduleId;
        long movieId;
        long movieScheduleId;
        string createdAt;
        string updatedAt;
    };

    struct Customer {
        long customerId;
        string username;
        string email;
        string password;               // Hashed password
        string phoneNumber;
        string fullName;
        string createdAt;
        string updatedAt;
    };

    struct Admin {
        long adminId;
        string username;
        string email;
        string password;               // Hashed password
        string fullName;
        string phoneNumber;
        string createdAt;
        string updatedAt;
    };

    struct ScheduleListSeat {
        long scheduleListSeatId;
        long scheduleId;
        long seatId;
        string status;                 // "available", "reserved", "booked"
        long bookingId;                // References booking that owns this seat (0 if available)
        string createdAt;
        string updatedAt;
    };

    struct Seat {
        long seatId;
        string seatRow;                // e.g., "A", "B", "C"
        long seatNumber;               // Seat number in the row
        string seatType;               // "regular", "vip", "premium"
        double seatPrice;
        string createdAt;
        string updatedAt;
    };

    struct Booking {
        long bookingId;
        long customerId;
        long scheduleId;
        sequence<long> scheduleListSeatIds;  // IDs from schedule_list_seats table
        string bookingStatus;          // "pending", "confirmed", "cancelled"
        double totalPrice;
        string bookingDate;
        string cancellationReason;     // NULL if not cancelled
        string createdAt;
        string updatedAt;
    };

    struct Review {
        long reviewId;
        long customerId;
        long movieId;
        long rating;  // 1-10
        string comment;
        string createdAt;
    };

    struct Payment {
        long paymentId;
        long bookingId;
        double amount;
        string paymentMethod;  // "credit_card", "cash", "online"
        string paymentStatus;  // "pending", "completed", "refunded"
        string paymentDate;
        string transactionId;
        string refundReason;   // NULL if not refunded
    };

    // ===== COMPLEX STRUCTS (FROM VIEWS) =====

    struct BookingDetails {
        // From v_booking_details view
        long bookingId;
        string bookingStatus;
        double totalPrice;
        string bookingDate;
        string cancellationReason;

        // Customer info
        long customerId;
        string customerName;
        string customerEmail;

        // Movie/Schedule info
        long scheduleId;
        long movieId;
        string movieTitle;
        string screeningDate;
        string screeningTime;

        // Seats info
        string seatsBooked;  // "A1, A2, B5" - concatenated from GROUP_CONCAT

        // Timestamps
        string createdAt;
        string updatedAt;
    };

    struct ScheduleDetails {
        // From v_schedule_details view
        long scheduleId;
        long movieId;
        long movieScheduleId;

        // Movie info
        string movieTitle;
        string movieDescription;
        long movieRating;
        string moviePosterURL;
        string movieGenres;    // Comma-separated string from GROUP_CONCAT

        // Schedule info
        string screeningDate;
        string screeningTime;

        // Availability
        long availableSeats;
        long totalSeats;

        string createdAt;
        string updatedAt;
    };

    struct SeatAvailability {
        // From v_seat_availability view
        long scheduleListSeatId;
        long scheduleId;
        long seatId;

        // Seat info
        string seatRow;
        long seatNumber;
        string seatType;
        double seatPrice;

        // Availability
        string status;  // "available", "reserved", "booked"

        // Context (for display)
        string movieTitle;
        string screeningDate;
        string screeningTime;
    };

    struct PaymentDetails {
        // From v_payment_details view
        long paymentId;
        long bookingId;
        double amount;
        string paymentMethod;
        string paymentStatus;
        string paymentDate;
        string transactionId;
        string refundReason;

        // Booking context
        long customerId;
        string customerName;
        string movieTitle;
        string screeningDate;
        string screeningTime;

        string createdAt;
        string updatedAt;
    };

    // ==================== TYPEDEFS FOR SEQUENCES ====================

    typedef sequence<Movie> MovieList;
    typedef sequence<MovieSchedule> MovieScheduleList;
    typedef sequence<Schedule> ScheduleList;
    typedef sequence<Customer> CustomerList;
    typedef sequence<Admin> AdminList;
    typedef sequence<ScheduleListSeat> ScheduleListSeatList;
    typedef sequence<ScheduleDetails> ScheduleDetailsList;
    typedef sequence<Seat> SeatList;
    typedef sequence<SeatAvailability> SeatAvailabilityList;
    typedef sequence<Booking> BookingList;
    typedef sequence<BookingDetails> BookingDetailsList;
    typedef sequence<Genre> GenreList;
    typedef sequence<string> GenreNameList;
    typedef sequence<long> IdList;
    typedef sequence<Payment> PaymentList;
    typedef sequence<PaymentDetails> PaymentDetailsList;
    typedef sequence<Review> ReviewList;

    // ==================== EXCEPTIONS ====================

    exception MovieNotFoundException {
        string message;
        long movieId;
    };

    exception ScheduleNotFoundException {
        string message;
        long scheduleId;
    };

    exception SeatNotAvailableException {
        string message;
        long seatId;
    };

    exception BookingException {
        string message;
        long errorCode;
    };

    exception AuthenticationException {
        string message;
    };

    exception InvalidInputException {
        string message;
        string fieldName;
    };

    exception PaymentException {
        string message;
        long errorCode;
    };

    exception PaymentNotFoundException {
        string message;
        long paymentId;
    };

    // ==================== COMMON INTERFACE ====================
    // Read-only operations available to both clients and admins

    interface CommonService {

        // ===== MOVIE QUERIES =====

        // Get all movies in the system
        MovieList getAllMovies();

        // Get a specific movie by ID
        Movie getMovieById(in long movieId)
            raises (MovieNotFoundException);

        // Filter movies by schedule date (returns movies showing on that date)
        MovieList filterMoviesByScheduleDate(in long dayNumber, in long monthNumber, in long yearNumber);

        // Filter movies by genre IDs (returns movies matching ANY of the genres)
        MovieList filterMoviesByGenreIds(in IdList genreIds);

        // Filter movies by genre names (returns movies matching ANY of the genres)
        MovieList filterMoviesByGenreNames(in GenreNameList genreNames);

        // Filter movies by minimum rating (returns movies >= rating)
        MovieList filterMoviesByRating(in long minRating);

        // Search movies by title (partial match, case-insensitive)
        MovieList searchMoviesByTitle(in string searchString);

        // ===== SCHEDULE QUERIES =====

        // Get all movie schedules
        MovieScheduleList getAllMovieSchedules();

        // Get all schedules for a specific movie by movie ID
        ScheduleList getSchedulesByMovieId(in long movieId) raises (MovieNotFoundException);

        // Get all schedules for a specific date
        ScheduleList getSchedulesByDate(
            in long dayNumber,
            in long monthNumber,
            in long yearNumber
        );

        // Get full schedule details (movie + schedule + seats) by schedule ID
        MovieSchedule getMovieScheduleById(in long scheduleId) raises (ScheduleNotFoundException);

        // Get schedule details with movie info (uses v_schedule_details view)
        ScheduleDetails getScheduleDetailsById(in long scheduleId) raises (ScheduleNotFoundException);

        // ===== GENRE QUERIES =====

        // Get all available genres
        GenreList getAllGenres();

        // Get a specific genre by ID
        Genre getGenreById(in long genreId);

        // Get genres for a specific movie
        GenreList getGenresByMovieId(in long movieId) raises (MovieNotFoundException);

        // ===== SEAT QUERIES =====

        // Get all seats for a specific schedule
        SeatList getSeatsByScheduleId(in long scheduleId) raises (ScheduleNotFoundException);

        // Get available seats for a specific schedule (uses v_available_seats_by_schedule view)
        SeatAvailabilityList getAvailableSeatsByScheduleId(in long scheduleId) raises (ScheduleNotFoundException);

        // Check if specific seats are available
        boolean areSeatsAvailable(in IdList scheduleListSeatIds);

        // Get schedule_list_seats entries for a schedule
        ScheduleListSeatList getScheduleSeats(in long scheduleId) raises (ScheduleNotFoundException);

        // Get specific schedule seat by ID
        ScheduleListSeat getScheduleSeatById(in long scheduleListSeatId);

        // Check seat availability for specific schedule
        boolean isSeatAvailableForSchedule(in long scheduleId, in long seatId);
    };
};